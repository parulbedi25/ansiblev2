@echo off
REM ===========================================================================
REM  {{ item.file }} - PostgreSQL {{ pg14_major_version }} {{ item.desc }}
REM  Generated by Ansible role postgres14 (ansible/windows-postgres14).
REM
REM  Calls the PostgreSQL {{ pg14_major_version }} binary by absolute path and
REM  pins port {{ pg14_port }}, so it can never talk to the legacy PostgreSQL
REM  10 instance on port {{ pg10_port }} by accident. The port is passed FIRST:
REM  if you add your own -p, yours comes later and wins.
REM ===========================================================================
"{{ pg14_bin_dir }}\{{ item.exe }}" -p {{ pg14_port }} %*
exit /b %ERRORLEVEL%
