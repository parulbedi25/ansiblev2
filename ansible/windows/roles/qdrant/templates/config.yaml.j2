# Qdrant configuration - generated by Ansible role roles/qdrant
# Docs: https://qdrant.tech/documentation/guides/configuration/
log_level: INFO

storage:
  # Persistent storage (durable - survives service restarts and reboots)
  storage_path: {{ qdrant_storage_dir | replace('\\', '/') }}
  snapshots_path: {{ qdrant_snapshots_dir | replace('\\', '/') }}

service:
  host: 0.0.0.0
  http_port: {{ qdrant_http_port }}
  grpc_port: {{ qdrant_grpc_port }}
{% if qdrant_api_key | length > 0 %}
  # Same value must be set as QASIP_HUB_QDRANT_API_KEY for the backend
  api_key: {{ qdrant_api_key }}
{% endif %}

telemetry_disabled: true
