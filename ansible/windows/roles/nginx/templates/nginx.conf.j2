    # ------------------------------------------------------------------
    # Knowledge Hub Admin UI (the ATMS server block above on
    # {{ nginx_listen_port }} is untouched)
    #   Backend : D:\copper-code\AI-Python\Knowledge_Hub - SEPARATE
    #             directory, Python/uvicorn app run by the NSSM service
    #             QASIP-KnowledgeHub on http://localhost:8037/ (direct).
    #             Nginx serves NO files from the backend directory.
    #   Frontend: D:\<project>-code\AI-Python\Knowledge_Hub_Admin - SEPARATE
    #             directory; Jenkins builds it (npm run build) and
    #             PUBLISHES dist into the Nginx root below, so Nginx
    #             serves the published copy, not the source directory:
    #   Admin UI : http://copper.qajarvis.com/ (port 80)
    #              /admin/, /health, /mcp and /mcp/ on this port are
    #              proxied to the backend so browser calls from the UI
    #              can stay same-origin (MCP/SSE needs buffering off).
    #   MCP proxy: http://<instance>:8040/mcp -> backend :8037 (below).
    # NOTE: this block is deliberately NOT conditional and uses
    # literal values: "listen 80;" must ALWAYS be present in the
    # rendered nginx.conf. A previous conditional/variable-only
    # version could render without the listener, after which the role
    # timed out waiting for the port while :6003 kept working.
    # The Jenkins pipeline publishes the Admin UI into html/knowledge-hub.
    # This matches the nginx.conf in production use on 10.10.6.116
    # (verified running as intended).
    # ------------------------------------------------------------------
    server {
        listen       80;
        server_name  copper.qajarvis.com;

        root   html/knowledge-hub;
        index  index.html;

        # Angular SPA fallback - all unknown paths return the app shell
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Knowledge Hub API (health) - reverse proxy to the backend
        location = /health {
            proxy_pass   http://127.0.0.1:8037;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
        }

        location /admin/ {
            proxy_pass   http://127.0.0.1:8037;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # MCP endpoint without trailing slash
        location = /mcp {
            proxy_pass   http://127.0.0.1:8037;

            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-QASIP-Tenant    $http_x_qasip_tenant;
            proxy_set_header Connection        "";

            proxy_buffering  off;
            proxy_cache      off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # MCP endpoint with trailing slash and subpaths.
        # proxy_buffering MUST stay off and HTTP/1.1 keep-alive on,
        # otherwise MCP/SSE events are buffered and never flush.
        location /mcp/ {
            proxy_pass   http://127.0.0.1:8037;

            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-QASIP-Tenant    $http_x_qasip_tenant;
            proxy_set_header Connection        "";

            proxy_buffering  off;
            proxy_cache      off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        client_max_body_size 50M;
    }

    # ------------------------------------------------------------------
    # Knowledge Hub MCP reverse proxy - port 8040
    #   Client : http://10.10.6.116:8040/mcp
    #   Backend: http://127.0.0.1:8037
    # ------------------------------------------------------------------
    server {
        listen       8040;

        location / {
            proxy_pass   http://127.0.0.1:8037;
            proxy_set_header Host 127.0.0.1:8037;
        }
    }

