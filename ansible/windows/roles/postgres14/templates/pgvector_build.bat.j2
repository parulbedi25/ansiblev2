@echo off
REM ===========================================================================
REM  Build and install pgvector {{ pg14_pgvector_version }} for PostgreSQL {{ pg14_major_version }}
REM  Generated by Ansible role postgres14 - do not edit on the host.
REM  Kept as a .bat file on purpose: one simple command per line, no chained
REM  "&& ^" one-liners (those fail silently under Ansible's cmd.exe handling).
REM ===========================================================================

REM 1. Load the Visual Studio C++ build environment (sets up nmake/cl)
call "{{ pg14_vcvars_path }}"
if errorlevel 1 exit /b %errorlevel%

REM 2. Tell pgvector which PostgreSQL installation to build against
set "PGROOT={{ pg14_install_dir }}"

REM 3. Build in the cloned pgvector source directory
cd /d "{{ pg14_temp_dir }}\pgvector"
if errorlevel 1 exit /b %errorlevel%

nmake /F Makefile.win
if errorlevel 1 exit /b %errorlevel%

nmake /F Makefile.win install
exit /b %errorlevel%
