pipeline {
    agent {
        label params.PROJECT_TARGET_MACHINE?.toLowerCase()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {

        string(
            name: 'PROJECT_TARGET_MACHINE',
            defaultValue: '',
            description: 'project-env-ip format (e.g. copper-dev-10.10.3.150)'
        )

        string(
            name: 'NOTIFICATION_EMAILS',
            defaultValue: '',
            description: 'Comma-separated emails'
        )

        choice(
            name: 'DEPLOY_DRIVE',
            choices: ['D', 'E', 'F'],
            description: 'Deployment drive'
        )
    }

    environment {

        PROJECT_NAME = "${params.PROJECT_TARGET_MACHINE?.toLowerCase()?.split('-')[0]}"
        PROJECT_ENV  = "${params.PROJECT_TARGET_MACHINE?.toLowerCase()?.split('-')[1]}"

        NEXUS_URL            = 'http://10.10.6.118:8081'
        NEXUS_REPO           = 'atms-modules'
        NEXUS_CREDENTIALS_ID = 'nexus-credentials'

        AI_DEPLOY_DIR = "${params.DEPLOY_DRIVE}:\\QASIP\\Apps\\python-ai-service"
        AI_APP_DIR    = "${params.DEPLOY_DRIVE}:\\QASIP\\Apps\\python-ai-service\\test_script_generator"

        SERVICE_NAME = 'ATMS-Python-AI'
    }

    stages {

        // =========================
        stage('Stop Python AI Service') {
            steps {
                bat '''
                    @echo off

                    echo ========================================
                    echo Stopping Python AI Service
                    echo ========================================

                    net stop ATMS-Python-AI 2>nul || echo Service was not running

                    echo Killing remaining Python processes...

                    taskkill /F /IM python.exe 2>nul || echo No python.exe found
                    taskkill /F /IM pythonw.exe 2>nul || echo No pythonw.exe found

                    ping 127.0.0.1 -n 5 > nul

                    echo Python AI Service stopped successfully
                '''
            }
        }

        // =========================
        stage('Download Artifact') {
            steps {
                script {

                    def parts = params.BUILD_VERSION.split('/')

                    def buildDate    = parts[0]
                    def artifactName = parts[1]

                    def nexusPath =
                        "${env.PROJECT_NAME}/windows/${env.PROJECT_ENV}/${buildDate}/AI-Python/${artifactName}"

                    echo "Nexus Path: ${nexusPath}"

                    withCredentials([usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {

                        bat """
                        @echo off
                        echo Downloading artifact...

                        curl.exe --fail -u "%NEXUS_USER%:%NEXUS_PASSWORD%" ^
                        -o "%AI_DEPLOY_DIR%\\AI-Python.tar.gz" ^
                        "${env.NEXUS_URL}/repository/${env.NEXUS_REPO}/${nexusPath}"

                        if %ERRORLEVEL% NEQ 0 exit /b 1

                        echo Download complete
                        """
                    }
                }
            }
        }

        // =========================
        stage('Extract Artifact') {
            steps {
                bat '''
                @echo off
                echo Extracting...

                tar -xzf "%AI_DEPLOY_DIR%\\AI-Python.tar.gz" -C "%AI_DEPLOY_DIR%"

                if %ERRORLEVEL% NEQ 0 exit /b 1

                del "%AI_DEPLOY_DIR%\\AI-Python.tar.gz"

                echo Extraction done
                '''
            }
        }

        // =========================
        stage('Setup Python Environment') {
            steps {
                bat '''
                @echo off
                setlocal EnableDelayedExpansion

                echo Setting up Python...

                set PYTHON_EXE=

                for /f "tokens=*" %%i in ('where python 2^>nul') do (
                    if "!PYTHON_EXE!"=="" set PYTHON_EXE=%%i
                )

                if "!PYTHON_EXE!"=="" exit /b 1

                cd /d "%AI_APP_DIR%"

                if exist ai_aenv rmdir /S /Q ai_aenv

                "!PYTHON_EXE!" -m venv ai_aenv
                call ai_aenv\\Scripts\\activate

                pip install -r Letest_requirements.txt
                pip install "flask[async]"

                echo Python environment ready
                '''
            }
        }

        // =========================
        stage('Create/Update Service') {
            steps {
                bat '''
                @echo off
                echo Configuring NSSM service...

                if not exist "%AI_APP_DIR%\\logs" mkdir "%AI_APP_DIR%\\logs"

                sc query ATMS-Python-AI >nul 2>&1

                if %ERRORLEVEL% NEQ 0 (
                    echo Creating service...
                    nssm install ATMS-Python-AI "%AI_APP_DIR%\\ai_aenv\\Scripts\\python.exe"
                )

                nssm set ATMS-Python-AI AppDirectory "%AI_APP_DIR%"
                nssm set ATMS-Python-AI AppParameters "run.py"
                nssm set ATMS-Python-AI AppStdout "%AI_APP_DIR%\\logs\\stdout.log"
                nssm set ATMS-Python-AI AppStderr "%AI_APP_DIR%\\logs\\stderr.log"

                echo Service configured
                '''
            }
        }

        // =========================
        stage('Start Service') {
            steps {
                bat '''
                @echo off
                echo Starting service...

                net stop ATMS-Python-AI 2>nul
                timeout /t 3 >nul
                net start ATMS-Python-AI

                echo Service started
                '''
            }
        }
    }

    post {
        success {
            echo """
            ====================================================
            DEPLOYMENT SUCCESSFUL
            ====================================================

            Target Machine : ${params.PROJECT_TARGET_MACHINE}
            Build Version  : ${params.BUILD_VERSION}
            Drive          : ${params.DEPLOY_DRIVE}

            ====================================================
            """
        }

        failure {
            echo """
            ====================================================
            DEPLOYMENT FAILED
            ====================================================

            Check logs for details

            ====================================================
            """
        }
    }
}