/*
 * Jenkinsfile-provision-macos  (QASIP-Instance Provisioning-Mac)
 * ============================================================================
 * macOS counterpart of Jenkinsfile-provision-windows
 * (QASIP-Instance Provisioning-Windows). Prepares a MacBook so the
 * QASIP application can be built/deployed onto it and opened in
 * Safari, the same way a Windows instance is prepared for a browser.
 *
 * macOS-specific differences vs the Windows version:
 *   - The target is a MacBook reached over SSH (port 22, Remote Login)
 *     instead of WinRM/Ansible-Windows; commands run as `sh` scripts
 *     over SSH from the Jenkins controller.
 *   - Software: on Apple Silicon, Homebrew (git, OpenJDK 8 + 17,
 *     Node, Python 3.11, Gradle, Nginx); on Intel, the official
 *     vendor packages instead (Homebrew dropped Intel in 2026) -
 *     nodejs.org Node, python.org Python 3.11, Eclipse Temurin
 *     JDK 17 + 8, gradle.org Gradle, nginx.org source build, git
 *     from the Xcode Command Line Tools. Plus a Tomcat 9 tarball
 *     under ~/QASIP/Apps - there is no Chocolatey, no Windows
 *     services, and no NSSM. GUI/browser side needs nothing
 *     special: Safari is built into macOS; the app is verified
 *     over http://<ip>:6003.
 *   - The Jenkins agent is registered with an SSH-launcher node
 *     config (Jenkins connects to the Mac itself), so no agent.jar
 *     service has to be installed on the Mac.
 *
 * Requirements on the MacBook before running:
 *   - "Remote Login" (SSH) enabled: System Settings > General >
 *     Sharing > Remote Login, for the provisioning user.
 *   - The provisioning user must be able to run sudo (Homebrew and
 *     system JDK links need it). The password parameter is used for
 *     both SSH and sudo -S.
 *   - A Jenkins SSH credential for the Mac should exist (see the
 *     Register stage notes); Homebrew's installer also needs Xcode
 *     Command Line Tools, which the script installs if missing.
 * ============================================================================
 */
pipeline {
    agent any
    parameters {
        string(
            name: 'PROJECT_NAME',
            description: 'Unique project identifier (example: copper, andes, gabilan, api). Used for node naming and labeling.'
        )
        choice(
            name: 'PROJECT_TYPE',
            choices: ['dev', 'poc', 'project'],
            description: 'Environment type: dev = development, poc = testing, project = QA/Production'
        )
        string(
            name: 'IP_ADDRESS',
            defaultValue: '',
            description: 'Target MacBook IP address for provisioning and agent registration'
        )
        string(
            name: 'USERNAME',
            defaultValue: '',
            description: 'Remote login username for the MacBook (SSH user)'
        )
        password(
            name: 'PASSWORD',
            defaultValue: '',
            description: 'Remote login password for the MacBook (also used for sudo on the Mac)'
        )
        string(
            name: 'NOTIFICATION_EMAILS',
            defaultValue: '',
            description: 'Comma-separated email addresses (example: user1@qasource.com, user2@qasource.com)'
        )
    }
    environment {
        ANSIBLE_OS = "macos"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    // Normalize values safely (NOTE: never lowercase a
                    // macOS username blindly if it contains uppercase;
                    // usernames are kept as entered, only trimmed.)
                    env.TARGET_IP       = params.IP_ADDRESS?.trim()
                    env.TARGET_USER     = params.USERNAME?.trim()
                    env.TARGET_PASSWORD = params.PASSWORD
                    env.PROJECT_NAME    = params.PROJECT_NAME?.trim()?.toLowerCase()
                    env.PROJECT_TYPE    = params.PROJECT_TYPE?.trim()?.toLowerCase()
                    env.NOTIFY_EMAILS   = params.NOTIFICATION_EMAILS?.trim()?.toLowerCase()
                    // Required validation
                    def required = [
                        'TARGET_IP',
                        'TARGET_USER',
                        'TARGET_PASSWORD',
                        'PROJECT_NAME',
                        'PROJECT_TYPE',
                        'NOTIFY_EMAILS'
                    ]
                    def missing = required.findAll { !env[it] }
                    if (missing) {
                        error """
BUILD FAILED ❌
Missing required parameters:
${missing.join('\n')}
"""
                    }
                    // Validate IP format
                    if (!(env.TARGET_IP ==~ /^(\d{1,3}\.){3}\d{1,3}$/)) {
                        error "Invalid IP address format → ${env.TARGET_IP}"
                    }
                    echo "Parameter validation successful ✅"

                    // Validate Email List
                    def emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/

                    def emailList = env.NOTIFY_EMAILS
                                        .split(',')
                                        .collect { it.trim() }
                                        .findAll { it }

                    // Duplicate check
                    def duplicates = emailList.groupBy { it }
                                            .findAll { it.value.size() > 1 }
                                            .keySet()

                    if (duplicates) {
                        error "Duplicate email(s) found: ${duplicates.join(', ')}"
                    }

                    // Format check
                    def invalidEmails = emailList.findAll { !(it ==~ emailRegex) }

                    if (invalidEmails) {
                        error """
        Invalid email format detected:
        ${invalidEmails.join('\n')}

        Expected format:
        user1@qasource.com, user2@qasource.com
        """
                    }

                    // Save clean list back to env (optional but recommended)
                    env.NOTIFY_EMAILS = emailList.join(',')

                    echo "Parameter validation successful ✅"
                }
            }
        }

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }
        stage('Validate Dependencies') {
            steps {
                script {
                    echo "Checking Git installation..."
                    if (sh(script: 'git --version', returnStatus: true) != 0)
                        error("Git is not installed on agent")
                    echo "Checking Python installation..."
                    if (sh(script: 'python3 --version', returnStatus: true) != 0)
                        error("Python is not installed on agent")
                    echo "Checking sshpass installation (needed for password SSH to the Mac)..."
                    if (sh(script: 'command -v sshpass', returnStatus: true) != 0) {
                        echo "sshpass not found — installing (controller package manager permitting)"
                        sh 'sudo apt-get install -y sshpass || brew install esolitos/ipa/sshpass || echo "WARNING: could not install sshpass automatically"'
                    }
                    if (sh(script: 'command -v sshpass', returnStatus: true) != 0)
                        error("sshpass is required on the controller for password-based SSH. Install it (apt-get install sshpass / brew install sshpass) or switch this pipeline to key-based SSH.")
                    echo "Dependency validation completed successfully"
                }
            }
        }

        // =============================================
        // Provision the MacBook over SSH:
        // Xcode CLT -> Homebrew -> toolchain -> QASIP layout
        // (Tomcat under ~/QASIP/Apps, Nginx prefix prepared).
        // =============================================
        stage('Provision MacBook via SSH') {
            steps {
                script {
                    env.MAC_NODE_NAME = "${env.PROJECT_NAME}-${env.PROJECT_TYPE}-${env.TARGET_IP}"
                    sh '''
                        set -e
                        export SSHPASS="$TARGET_PASSWORD"
                        SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
                        SSH_CMD="sshpass -e ssh $SSH_OPTS ${TARGET_USER}@${TARGET_IP}"
                        SCP_CMD="sshpass -e scp $SSH_OPTS"

                        echo "========================================"
                        echo "Provisioning MacBook ${TARGET_USER}@${TARGET_IP}"
                        echo "========================================"

                        # Remote provisioning script (runs on the Mac).
                        cat > /tmp/qasip_provision_mac.sh <<'REMOTE_EOF'
set -e
echo "== macOS info =="
sw_vers
uname -m

echo "== Xcode Command Line Tools =="
# NOTE: `xcode-select -p` alone is not proof the tools work - a stale or
# half-upgraded CLT directory makes it succeed while clang/make are
# missing (Homebrew then fails with "No developer tools installed").
# Verify the compiler and make actually run:
clt_ok() {
    xcode-select -p >/dev/null 2>&1 && clang --version >/dev/null 2>&1 && xcrun --find make >/dev/null 2>&1
}
if ! clt_ok; then
    if xcode-select -p >/dev/null 2>&1; then
        echo "Command Line Tools directory exists but the tools do not run - removing the stale install and reinstalling..."
        echo "$TARGET_PASSWORD" | sudo -S rm -rf /Library/Developer/CommandLineTools 2>/dev/null || true
        echo "$TARGET_PASSWORD" | sudo -S xcode-select --reset 2>/dev/null || true
    fi
    echo "Installing Xcode Command Line Tools (headless, via softwareupdate)..."
    echo "NOTE: this can take 10-30 minutes depending on the network - do not cancel the build."
    # Headless install: `xcode-select --install` only opens a GUI dialog
    # that nobody can click in an SSH session, and `xcode-select -p`
    # errors until the tools exist. The supported unattended path is
    # softwareupdate with the on-demand marker file:
    echo "$TARGET_PASSWORD" | sudo -S touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress 2>/dev/null || true
    CLT_LABEL="$(softwareupdate -l 2>/dev/null | grep -i 'Command Line Tools' | tail -1 | sed -e 's/.*Label: //' -e 's/^[* ]*//')"
    if [ -n "$CLT_LABEL" ]; then
        echo "Installing via softwareupdate: $CLT_LABEL"
        echo "$TARGET_PASSWORD" | sudo -S softwareupdate -i "$CLT_LABEL" --verbose || true
    else
        echo "softwareupdate did not list a CLT package - falling back to xcode-select --install (needs a GUI click on the Mac if a dialog appears)"
        xcode-select --install || true
    fi
    echo "$TARGET_PASSWORD" | sudo -S rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress 2>/dev/null || true
    # Wait for the tools to become available (max ~30 minutes, progress each minute)
    for i in $(seq 1 180); do
        if clt_ok; then
            echo "Xcode Command Line Tools ready after ~$((i * 10)) seconds: $(xcode-select -p)"
            break
        fi
        if [ $((i % 6)) -eq 0 ]; then
            echo "Still waiting for Xcode Command Line Tools... ($((i / 6)) minute(s) elapsed, up to 30)"
        fi
        sleep 10
    done
    if ! clt_ok; then
        echo "ERROR: Xcode Command Line Tools still not working after 30 minutes."
        echo "On the Mac, run:  xcode-select --install   (and click Install in the dialog), then re-run this pipeline."
        exit 1
    fi
else
    echo "Already installed and working: $(xcode-select -p)"
    clang --version | head -1
fi

if [ "$(uname -m)" = "x86_64" ]; then
    # =============================================
    # Intel Mac: official vendor packages only.
    # Homebrew no longer supports Intel (its installer aborts and it
    # ships no Intel bottles, so installs fall back to source builds
    # that fail without a full toolchain). git/clang/make come from
    # the Xcode Command Line Tools above; everything else comes from
    # the vendor's own distribution:
    #   Node.js  - nodejs.org official macOS x64 tarball
    #   Python   - python.org official macOS installer (.pkg)
    #   Java     - Eclipse Temurin (Adoptium) 17 + 8 tarballs
    #   Gradle   - gradle.org official distribution zip
    #   Nginx    - nginx.org official source tarball (compiled with
    #              the CLT compiler; no official macOS binary exists)
    # =============================================
    echo "== Toolchain (Intel - official vendor packages, no Homebrew) =="
    export PATH="/usr/local/bin:$PATH"
    echo "$TARGET_PASSWORD" | sudo -S mkdir -p /usr/local/bin /usr/local/opt /Library/Java/JavaVirtualMachines 2>/dev/null || true

    if ! command -v node >/dev/null 2>&1; then
        NODE_VERSION="22.14.0"
        echo "Installing Node.js $NODE_VERSION (nodejs.org)..."
        curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-darwin-x64.tar.gz" -o /tmp/node.tar.gz
        rm -rf "/tmp/node-v${NODE_VERSION}-darwin-x64"
        tar -xzf /tmp/node.tar.gz -C /tmp
        echo "$TARGET_PASSWORD" | sudo -S cp -R "/tmp/node-v${NODE_VERSION}-darwin-x64/." /usr/local/
        rm -rf "/tmp/node-v${NODE_VERSION}-darwin-x64" /tmp/node.tar.gz
    fi

    if ! /usr/local/bin/python3.11 --version >/dev/null 2>&1 && ! /Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11 --version >/dev/null 2>&1; then
        echo "Installing Python 3.11.9 (python.org)..."
        curl -fsSL "https://www.python.org/ftp/python/3.11.9/python-3.11.9-macos11.pkg" -o /tmp/python311.pkg
        echo "$TARGET_PASSWORD" | sudo -S installer -pkg /tmp/python311.pkg -target /
        rm -f /tmp/python311.pkg
    fi

    if [ ! -x /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home/bin/java ]; then
        echo "Installing Eclipse Temurin JDK 17 (Adoptium)..."
        curl -fsSL "https://api.adoptium.net/v3/binary/latest/17/ga/mac/x64/jdk/hotspot/normal/eclipse" -o /tmp/temurin17.tar.gz
        rm -rf /tmp/temurin17 && mkdir -p /tmp/temurin17
        tar -xzf /tmp/temurin17.tar.gz -C /tmp/temurin17
        echo "$TARGET_PASSWORD" | sudo -S rm -rf /Library/Java/JavaVirtualMachines/temurin-17.jdk
        echo "$TARGET_PASSWORD" | sudo -S cp -R /tmp/temurin17/jdk-17*/Contents /Library/Java/JavaVirtualMachines/temurin-17.jdk
        rm -rf /tmp/temurin17 /tmp/temurin17.tar.gz
    fi

    if [ ! -x /Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home/bin/java ]; then
        echo "Installing Eclipse Temurin JDK 8 (Adoptium)..."
        curl -fsSL "https://api.adoptium.net/v3/binary/latest/8/ga/mac/x64/jdk/hotspot/normal/eclipse" -o /tmp/temurin8.tar.gz
        rm -rf /tmp/temurin8 && mkdir -p /tmp/temurin8
        tar -xzf /tmp/temurin8.tar.gz -C /tmp/temurin8
        echo "$TARGET_PASSWORD" | sudo -S rm -rf /Library/Java/JavaVirtualMachines/temurin-8.jdk
        echo "$TARGET_PASSWORD" | sudo -S cp -R /tmp/temurin8/jdk8u*/Contents /Library/Java/JavaVirtualMachines/temurin-8.jdk
        rm -rf /tmp/temurin8 /tmp/temurin8.tar.gz
    fi

    if ! command -v gradle >/dev/null 2>&1; then
        GRADLE_VERSION="8.10.2"
        echo "Installing Gradle $GRADLE_VERSION (gradle.org)..."
        curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip
        rm -rf "/tmp/gradle-${GRADLE_VERSION}"
        unzip -q -o /tmp/gradle.zip -d /tmp
        echo "$TARGET_PASSWORD" | sudo -S rm -rf "/usr/local/opt/gradle-${GRADLE_VERSION}"
        echo "$TARGET_PASSWORD" | sudo -S cp -R "/tmp/gradle-${GRADLE_VERSION}" /usr/local/opt/
        echo "$TARGET_PASSWORD" | sudo -S ln -sfn "/usr/local/opt/gradle-${GRADLE_VERSION}" /usr/local/opt/gradle
        echo "$TARGET_PASSWORD" | sudo -S ln -sfn /usr/local/opt/gradle/bin/gradle /usr/local/bin/gradle
        rm -rf "/tmp/gradle-${GRADLE_VERSION}" /tmp/gradle.zip
    fi

    if ! command -v nginx >/dev/null 2>&1; then
        NGINX_VERSION="1.26.2"
        echo "Installing nginx $NGINX_VERSION (nginx.org source build)..."
        curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz
        rm -rf "/tmp/nginx-${NGINX_VERSION}"
        tar -xzf /tmp/nginx.tar.gz -C /tmp
        cd "/tmp/nginx-${NGINX_VERSION}"
        ./configure --prefix=/usr/local/opt/nginx --without-http_rewrite_module
        make -j4
        echo "$TARGET_PASSWORD" | sudo -S make install
        echo "$TARGET_PASSWORD" | sudo -S ln -sfn /usr/local/opt/nginx/sbin/nginx /usr/local/bin/nginx
        cd /
        rm -rf "/tmp/nginx-${NGINX_VERSION}" /tmp/nginx.tar.gz
    fi
    # mime.types for the private QASIP nginx prefix used by Deploy
    mkdir -p "$HOME/QASIP/Apps/nginx/conf"
    cp /usr/local/opt/nginx/conf/mime.types "$HOME/QASIP/Apps/nginx/conf/mime.types" || true

    /usr/libexec/java_home -V 2>&1 || true
    /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home/bin/java -version 2>&1 || true
    /Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home/bin/java -version 2>&1 || true
    node --version
    /usr/local/bin/python3.11 --version || /Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11 --version
    gradle --version | head -5 || true
    nginx -v 2>&1 || true
else
    echo "== Homebrew (Apple Silicon) =="
    if ! command -v brew >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/brew ]; then
        echo "Installing Homebrew (can take 5-15 minutes - it downloads and pours bottles)..."
        echo "$TARGET_PASSWORD" | sudo -S -v || true
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        # Wait for brew to become usable (max ~10 minutes, progress each minute)
        for i in $(seq 1 60); do
            if [ -x /opt/homebrew/bin/brew ] || command -v brew >/dev/null 2>&1; then
                echo "Homebrew ready after ~$((i * 10)) seconds."
                break
            fi
            if [ $((i % 6)) -eq 0 ]; then
                echo "Still waiting for Homebrew... ($((i / 6)) minute(s) elapsed, up to 10)"
            fi
            sleep 10
        done
    fi
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    brew --version

    echo "== Toolchain (Homebrew) =="
    # git/curl ship with macOS; install the QASIP build/run toolchain.
    brew install git node python@3.11 gradle nginx || brew upgrade git node python@3.11 gradle nginx || true

    echo "== Java (JDK 17 for Jenkins/Tomcat tooling, JDK 8 for the legacy app if available) =="
    brew install openjdk@17 || brew upgrade openjdk@17 || true
    brew install openjdk@8 || echo "NOTE: openjdk@8 not available from Homebrew core on this Mac - install a JDK 8 (e.g. Azul Zulu 8) manually if the Java app will not run on 17."
    # Make JDK 17 discoverable by /usr/libexec/java_home
    echo "$TARGET_PASSWORD" | sudo -S ln -sfn "$(brew --prefix openjdk@17)/libexec/openjdk.jdk" /Library/Java/JavaVirtualMachines/openjdk-17.jdk 2>/dev/null || echo "WARNING: could not link JDK 17 into /Library/Java (continuing - java_home may not list it)"
    /usr/libexec/java_home -V 2>&1 || true
    java -version 2>&1 || true
    node --version
    python3 --version
    gradle --version | head -5 || true
    nginx -v 2>&1 || true
fi

echo "== QASIP directory layout (mirrors D:\\QASIP on Windows) =="
mkdir -p "$HOME/QASIP/Apps/tomcat" "$HOME/QASIP/Apps/nginx/html" "$HOME/QASIP/Apps/nginx/conf" "$HOME/QASIP/Apps/nginx/logs" \
         "$HOME/QASIP/Apps/python-ai-service" "$HOME/QASIP/Apps/node-service" \
         "$HOME/QASIP/Scripts" "$HOME/QASIP/run" "$HOME/QASIP/logs" "$HOME/deploys" "$HOME/jenkins"

echo "== Tomcat 9 (tarball into ~/QASIP/Apps/tomcat) =="
TOMCAT_VERSION="9.0.98"
if [ ! -x "$HOME/QASIP/Apps/tomcat/bin/catalina.sh" ]; then
    TOMCAT_MAJOR="${TOMCAT_VERSION%%.*}"
    TOMCAT_URL="https://archive.apache.org/dist/tomcat/tomcat-${TOMCAT_MAJOR}/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz"
    echo "Downloading $TOMCAT_URL"
    curl -fsSL "$TOMCAT_URL" -o /tmp/apache-tomcat.tar.gz
    tar -xzf /tmp/apache-tomcat.tar.gz -C /tmp
    cp -R "/tmp/apache-tomcat-${TOMCAT_VERSION}/." "$HOME/QASIP/Apps/tomcat/"
    chmod +x "$HOME/QASIP/Apps/tomcat/bin/"*.sh
    rm -f /tmp/apache-tomcat.tar.gz
fi
"$HOME/QASIP/Apps/tomcat/bin/catalina.sh" version 2>/dev/null | head -3 || true

echo "== Ports sanity (must be free or already ours: 6003 UI, 8080 Tomcat, 4001 Node) =="
for port in 6003 8080 4001; do
    if lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
        echo "Port $port: in use by:"
        lsof -iTCP:"$port" -sTCP:LISTEN | head -3
    else
        echo "Port $port: free"
    fi
done

echo "== Safari =="
if [ -d "/Applications/Safari.app" ]; then
    echo "Safari present (built into macOS) - the deployed app will open at http://${TARGET_IP}:6003 after QASIP-Deploy-Mac runs."
else
    echo "WARNING: Safari.app not found (unexpected on macOS)."
fi

echo "PROVISIONING_DONE"
REMOTE_EOF

                        echo "Copying provisioning script to the Mac..."
                        $SCP_CMD /tmp/qasip_provision_mac.sh "${TARGET_USER}@${TARGET_IP}:/tmp/qasip_provision_mac.sh"

                        echo "Running provisioning script on the Mac (this can take several minutes)..."
                        $SSH_CMD "TARGET_PASSWORD='$TARGET_PASSWORD' bash /tmp/qasip_provision_mac.sh"

                        echo "MacBook provisioning completed."
                    '''
                }
            }
        }

        // =============================================
        // Register the Mac as a Jenkins agent (SSH launcher).
        // Jenkins itself connects to the Mac over SSH, so - unlike
        // the Windows agent - nothing has to run permanently on the
        // Mac besides Remote Login. Requires an SSH username/password
        // (or key) credential in Jenkins whose ID matches the node
        // name; the stage tells you if it has to be created first.
        // =============================================
        stage('Register Jenkins Agent') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'jenkins-api-creds',
                            usernameVariable: 'JENKINS_USER',
                            passwordVariable: 'JENKINS_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -e
                            NODE_NAME="${PROJECT_NAME}-${PROJECT_TYPE}-${TARGET_IP}"
                            LABELS="${PROJECT_NAME}-${PROJECT_TYPE}-${TARGET_IP} ${PROJECT_NAME}-${PROJECT_TYPE} macos ${PROJECT_NAME}-mac"

                            echo "Registering Jenkins node: $NODE_NAME (labels: $LABELS)"

                            # Does an SSH credential with the node name as ID exist?
                            CRED_ID="$NODE_NAME"
                            CRED_CHECK=$(curl -s -o /dev/null -w "%{http_code}" -u "$JENKINS_USER:$JENKINS_TOKEN" \
                              "$JENKINS_URL/credentials/store/system/domain/_/credential/$CRED_ID/api/json" || true)
                            if [ "$CRED_CHECK" != "200" ]; then
                                echo "WARNING: No Jenkins credential with ID '$CRED_ID' found."
                                echo "Create it once in Jenkins (Manage Jenkins > Credentials):"
                                echo "  Kind: Username with password (or SSH Username with private key)"
                                echo "  ID:   $CRED_ID"
                                echo "  User: ${TARGET_USER}  (the Mac login user)"
                                echo "Then re-run this pipeline (or just this stage via Restart from Stage)."
                            fi

                            # Jenkins crumb for CSRF protection
                            CRUMB=$(curl -s -u "$JENKINS_USER:$JENKINS_TOKEN" "$JENKINS_URL/crumbIssuer/api/json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('crumbRequestField','')+':'+d.get('crumb',''))" 2>/dev/null || echo "")

                            cat > /tmp/mac_node.xml <<EOF
<?xml version='1.1' encoding='UTF-8'?>
<slave>
  <name>$NODE_NAME</name>
  <description>QASIP MacBook agent (${PROJECT_NAME}-${PROJECT_TYPE}) - macOS, Safari target</description>
  <remoteFS>/Users/${TARGET_USER}/jenkins</remoteFS>
  <numExecutors>2</numExecutors>
  <mode>EXCLUSIVE</mode>
  <retentionStrategy class="hudson.slaves.RetentionStrategy\$Always"/>
  <launcher class="hudson.plugins.sshslaves.SSHLauncher" plugin="ssh-slaves">
    <host>${TARGET_IP}</host>
    <port>22</port>
    <credentialsId>$CRED_ID</credentialsId>
    <launchTimeoutSeconds>60</launchTimeoutSeconds>
    <maxNumRetries>3</maxNumRetries>
    <retryWaitTime>15</retryWaitTime>
    <sshHostKeyVerificationStrategy class="hudson.plugins.sshslaves.verifiers.NonVerifyingKeyVerificationStrategy"/>
    <tcpNoDelay>true</tcpNoDelay>
  </launcher>
  <label>$LABELS</label>
  <nodeProperties/>
</slave>
EOF

                            HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -u "$JENKINS_USER:$JENKINS_TOKEN" \
                              -H "$CRUMB" -H "Content-Type: application/xml" \
                              --data-binary @/tmp/mac_node.xml \
                              "$JENKINS_URL/computer/doCreateItem?name=$NODE_NAME&type=hudson.slaves.DumbSlave")
                            echo "Create node HTTP: $HTTP_CODE"
                            if [ "$HTTP_CODE" = "200" ]; then
                                echo "Node $NODE_NAME created."
                            else
                                echo "Node may already exist (HTTP $HTTP_CODE) - updating its config instead..."
                                curl -s -o /dev/null -w "Config update HTTP: %{http_code}\n" -u "$JENKINS_USER:$JENKINS_TOKEN" \
                                  -H "$CRUMB" -H "Content-Type: application/xml" \
                                  --data-binary @/tmp/mac_node.xml \
                                  "$JENKINS_URL/computer/$NODE_NAME/config.xml" || true
                            fi

                            echo "Bringing node online (Jenkins connects over SSH)..."
                            curl -s -o /dev/null -w "Toggle offline HTTP: %{http_code}\n" -u "$JENKINS_USER:$JENKINS_TOKEN" \
                              -H "$CRUMB" -X POST \
                              "$JENKINS_URL/computer/$NODE_NAME/toggleOffline?offlineMessage=provisioned" || true

                            echo "Agent registration step done. Verify in Jenkins: Manage Jenkins > Nodes > $NODE_NAME"
                        '''
                    }
                }
            }
        }

        stage('Install Node Dependencies') {
            steps {
                sh 'cd scripts && npm install'
            }
        }
    }

    post {
        success {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {

                    def node_name = "${params.PROJECT_NAME}-${params.PROJECT_TYPE}-${params.IP_ADDRESS}"
                    def executionTime = currentBuild.durationString.replace(' and counting', '')

                    echo """
    ========================================
    PIPELINE PASSED
    ========================================
    Project Name  : ${params.PROJECT_NAME}
    Project Type  : ${params.PROJECT_TYPE}
    IP Address    : ${params.IP_ADDRESS}
    Agent Name    : ${node_name}
    Execution Time: ${executionTime}
    Build URL     : ${env.BUILD_URL}
    ========================================
    """

                    sh """
                    node scripts/sendProvisioningEmail.js \\
                    --smtpServer=$SMTP_SERVER \\
                    --smtpUser=$SMTP_USER \\
                    --smtpPassword=$SMTP_PASSWORD \\
                    --smtpPort=$SMTP_PORT \\
                    --senderName="DevOps QASIP" \\
                    --senderEmail="copper@qasource.com" \\
                    --receiverEmail="${params.NOTIFICATION_EMAILS}" \\
                    --projectName="${params.PROJECT_NAME}" \\
                    --projectType="${params.PROJECT_TYPE}" \\
                    --ipAddress="${params.IP_ADDRESS}" \\
                    --osType="${env.ANSIBLE_OS}" \\
                    --agentName="${node_name}" \\
                    --executionTime="${executionTime}" \\
                    --status="success"
                    """
                }
            }
        }
        failure {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {
                    echo """
    =======================================
    ❌ PIPELINE FAILED
    =======================================
    =======================================
    """
                }
            }
        }
    }
}
