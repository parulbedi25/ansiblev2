/*
 * Jenkinsfile-build-knowledgehub-windows
 * ============================================================================
 * Builds & deploys the Knowledge Hub (backend + admin frontend) on a Windows
 * target where the code already lives at D:\copper-code\AI-Python.
 *
 * Prerequisites (done ONCE by Ansible provisioning - windows.yml):
 *   - postgres14 role : PostgreSQL 18 on port 5433, database qasip_hub
 *                       + one-time SQL from the deployment strategy:
 *                         CREATE USER kh_app WITH PASSWORD '...';
 *                         GRANT ALL PRIVILEGES ON DATABASE qasip_hub TO kh_app;
 *                         \c qasip_hub -> GRANT USAGE, CREATE ON SCHEMA public TO kh_app;
 *   - qdrant role     : Qdrant service on port 6333 (persistent storage)
 *   - python312 role  : Python 3.12 at C:\Program Files\Python312\python.exe
 *                       (plain `python` on these hosts is still Python 3.11!)
 *   - node18 role     : Node 18 at D:\QASIP\Apps\node18
 *                       (plain `node` on these hosts is still Node 10!)
 *   - nssm role       : NSSM available (backend runs as a Windows service)
 *
 * Jenkins credentials to create (Manage Jenkins -> Credentials):
 *   - knowledgehub-openai-api-key    (Secret text)  OpenAI / Azure OpenAI key
 *   - knowledgehub-qdrant-api-key    (Secret text)  Qdrant API key (if enabled;
 *                                                   any value if Qdrant has no key)
 *   - knowledgehub-db-credentials    (Username+password) kh_app DB user/password
 * (QASIP_HUB_SECRET_KEY is NOT a Jenkins credential: the pipeline generates a
 *  Fernet key itself - see the 'Generate Secret Key' stage.)
 *
 * Hostnames are NOT parameters: the infra pipeline (hosts-entry role) already
 * added "qajarvis.com" and "<instance>.qajarvis.com" to the Windows hosts
 * file, so this pipeline derives the target hostname itself at runtime
 * (KNOWLEDGE_HUB_HOSTNAME = <project>.qajarvis.com, project = first part of
 * PROJECT_TARGET_MACHINE) and fills QASIP_HUB_PUBLIC_URL, CORS_ORIGINS,
 * QDRANT_URL, the DATABASE_URL host and VITE_HUB_API_URL from it.
 *
 * Frontend is published into a SUBFOLDER of the existing Nginx html dir
 * (default: knowledge-hub) so the existing Angular UI hosted there is never
 * touched. Nginx needs a matching location block for that path with SPA
 * fallback (try_files $uri $uri/ /<path>/index.html) - see stage 11 output.
 * ============================================================================
 */
pipeline {
    agent {
        label params.PROJECT_TARGET_MACHINE.toLowerCase()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {
        string(
            name: 'PROJECT_TARGET_MACHINE',
            description: 'Jenkins agent label where the application will be deployed. Format: project-environment-ip (example: copper-dev-10.10.3.150). Ensure the label exactly matches an existing Jenkins node.'
        )
        string(
            name: 'NOTIFICATION_EMAILS',
            defaultValue: '',
            description: 'Comma-separated email addresses (example: user1@qasource.com, user2@qasource.com)'
        )
    }

    environment {
        // Keys follow the common deploy-pipeline header, prefixed with
        // KNOWLEDGE_HUB_ so this job's values never clash with other apps.
        KNOWLEDGE_HUB_PROJECT_NAME         = "${params.PROJECT_TARGET_MACHINE.toLowerCase().split('-')[0]}"
        KNOWLEDGE_HUB_NEXUS_URL            = 'http://10.10.5.220:8081'
        KNOWLEDGE_HUB_NEXUS_REPO           = 'atms-modules'
        KNOWLEDGE_HUB_NEXUS_CREDENTIALS_ID = 'nexus-credentials'
        KNOWLEDGE_HUB_TOMCAT_HOME          = 'D:\\QASIP\\Apps\\tomcat'
        KNOWLEDGE_HUB_TOMCAT_WEBAPPS       = 'D:\\QASIP\\Apps\\tomcat\\webapps'
        KNOWLEDGE_HUB_TOMCAT_ROOT          = 'D:\\QASIP\\Apps\\tomcat\\webapps\\ROOT'
        KNOWLEDGE_HUB_TOMCAT_LOGS          = 'D:\\QASIP\\Apps\\tomcat\\logs'
        KNOWLEDGE_HUB_NGINX_ROOT_DIR       = 'D:\\QASIP\\Apps\\nginx'
        KNOWLEDGE_HUB_NGINX_HTML_DIR       = 'D:\\QASIP\\Apps\\nginx\\html'
        KNOWLEDGE_HUB_AI_DEPLOY_DIR        = 'D:\\QASIP\\Apps\\python-ai-service'
        KNOWLEDGE_HUB_AI_APP_DIR           = 'D:\\QASIP\\Apps\\python-ai-service\\test_script_generator'
        KNOWLEDGE_HUB_NODE_DEPLOY_DIR      = 'D:\\QASIP\\Apps\\node-service'
        KNOWLEDGE_HUB_ANSIBLE_OS           = "windows"
        // Python path is fixed to the side-by-side Python 3.12 installed by
        // Ansible (plain `python` on these machines is still Python 3.11)

        // ---- Knowledge Hub specific (code is already on the machine) ----
        KNOWLEDGE_HUB_CODE_DIR     = 'D:\\copper-code\\AI-Python'
        KNOWLEDGE_HUB_BACKEND_DIR  = "${KNOWLEDGE_HUB_CODE_DIR}\\Knowledge_Hub"
        KNOWLEDGE_HUB_FRONTEND_DIR = "${KNOWLEDGE_HUB_CODE_DIR}\\Knowledge_Hub_Admin"
        KNOWLEDGE_HUB_VENV_DIR     = "${KNOWLEDGE_HUB_BACKEND_DIR}\\.venv"
        KNOWLEDGE_HUB_PYTHON_EXE   = 'C:\\Program Files\\Python312\\python.exe'
        KNOWLEDGE_HUB_NODE18_DIR   = 'D:\\QASIP\\Apps\\node18'
        KNOWLEDGE_HUB_SERVICE_NAME = 'QASIP-KnowledgeHub'
        KNOWLEDGE_HUB_LOG_DIR      = "${KNOWLEDGE_HUB_BACKEND_DIR}\\logs"
        KNOWLEDGE_HUB_ADMIN_UI_PATH = 'knowledge-hub'

        // ---- Hostname (derived, not a parameter) ----
        // The infra pipeline's hosts-entry role already added
        // "qajarvis.com" and "<instance>.qajarvis.com" to the Windows hosts
        // file, so the hostname is filled here during pipeline execution.
        KNOWLEDGE_HUB_HOSTNAME = "${KNOWLEDGE_HUB_PROJECT_NAME}.qajarvis.com"

        // ---- QASIP_HUB_* backend application environment ----
        // (These names are read by the Knowledge Hub app itself, so they
        //  keep their QASIP_HUB_ names; secrets come from Jenkins
        //  credentials / the generated secret key - never from git.)
        QASIP_HUB_HOST                 = '0.0.0.0'
        QASIP_HUB_PORT                 = '8000'
        QASIP_HUB_RELOAD               = 'false'
        QASIP_HUB_CORS_ORIGINS         = "https://${KNOWLEDGE_HUB_HOSTNAME}"
        QASIP_HUB_PUBLIC_URL           = "https://${KNOWLEDGE_HUB_HOSTNAME}"
        QASIP_HUB_LLM_PROVIDER         = 'openai'
        QASIP_HUB_OPENAI_MODEL         = ''
        QASIP_HUB_AZURE_OPENAI_ENDPOINT    = ''
        QASIP_HUB_AZURE_OPENAI_API_VERSION = ''
        QASIP_HUB_AZURE_OPENAI_DEPLOYMENT  = ''
        QASIP_HUB_EMBEDDING_PROVIDER   = 'local'
        QASIP_HUB_LOCAL_EMBEDDING_MODEL = 'BAAI/bge-small-en-v1.5'
        QASIP_HUB_VECTOR_BACKEND       = 'qdrant'
        QASIP_HUB_QDRANT_URL           = "http://${KNOWLEDGE_HUB_HOSTNAME}:6333"
        QASIP_HUB_QDRANT_COLLECTION    = 'ku_index'
        QASIP_HUB_LOG_LEVEL            = 'INFO'
        QASIP_HUB_AUDIT_ENABLED        = 'true'

        // Frontend build variable (baked into the JS bundle at build time)
        VITE_HUB_API_URL = "https://${KNOWLEDGE_HUB_HOSTNAME}"
    }

    stages {

        // ------------------------------------------------------------------
        stage('Validate Parameters') {
            steps {
                script {
                    def missing = []
                    if (!params.PROJECT_TARGET_MACHINE?.trim()) missing << 'PROJECT_TARGET_MACHINE'
                    if (missing) {
                        error "Missing required parameters: ${missing.join(', ')}"
                    }
                    echo """
                    ========================================
                    KNOWLEDGE HUB DEPLOYMENT
                    ========================================
                    Target Machine : ${params.PROJECT_TARGET_MACHINE}
                    Hostname       : ${env.KNOWLEDGE_HUB_HOSTNAME} (hosts entry from infra pipeline)
                    Code Directory : ${env.KNOWLEDGE_HUB_CODE_DIR}
                    Backend Dir    : ${env.KNOWLEDGE_HUB_BACKEND_DIR}
                    Frontend Dir   : ${env.KNOWLEDGE_HUB_FRONTEND_DIR}
                    Backend Service: ${env.KNOWLEDGE_HUB_SERVICE_NAME} (port ${env.QASIP_HUB_PORT})
                    LLM Provider   : ${env.QASIP_HUB_LLM_PROVIDER}
                    ========================================
                    """
                }
            }
        }

        // ------------------------------------------------------------------
        stage('Resolve Host Entries') {
            steps {
                bat """
                    @echo off
                    echo ========================================
                    echo Resolving hostname from hosts entries
                    echo ========================================

                    echo Machine hostname:
                    hostname

                    echo Checking hosts entry for ${env.KNOWLEDGE_HUB_HOSTNAME} ...
                    findstr /I /C:"${env.KNOWLEDGE_HUB_HOSTNAME}" "%SystemRoot%\\System32\\drivers\\etc\\hosts" >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: No hosts entry for ${env.KNOWLEDGE_HUB_HOSTNAME}
                        echo The infra pipeline ^(hosts-entry role^) must run first - it adds
                        echo qajarvis.com and ${env.KNOWLEDGE_HUB_HOSTNAME} to the Windows hosts file.
                        exit /b 1
                    )
                    echo [OK] Hosts entry found for ${env.KNOWLEDGE_HUB_HOSTNAME}

                    echo Filled during this pipeline execution:
                    echo   QASIP_HUB_PUBLIC_URL  = ${env.QASIP_HUB_PUBLIC_URL}
                    echo   QASIP_HUB_CORS_ORIGINS= ${env.QASIP_HUB_CORS_ORIGINS}
                    echo   QASIP_HUB_QDRANT_URL  = ${env.QASIP_HUB_QDRANT_URL}
                    echo   DATABASE host         = ${env.KNOWLEDGE_HUB_HOSTNAME}:5433
                    echo   VITE_HUB_API_URL      = ${env.VITE_HUB_API_URL}
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Verify Source Code') {
            steps {
                bat """
                    @echo off
                    echo ========================================
                    echo Verifying code already present on this machine
                    echo ========================================

                    if not exist "${env.KNOWLEDGE_HUB_BACKEND_DIR}" (
                        echo ERROR: Backend code not found at ${env.KNOWLEDGE_HUB_BACKEND_DIR}
                        echo Expected the AI-Python code at ${env.KNOWLEDGE_HUB_CODE_DIR} on this machine.
                        exit /b 1
                    )
                    if not exist "${env.KNOWLEDGE_HUB_FRONTEND_DIR}" (
                        echo ERROR: Frontend code not found at ${env.KNOWLEDGE_HUB_FRONTEND_DIR}
                        exit /b 1
                    )
                    echo [OK] Backend code : ${env.KNOWLEDGE_HUB_BACKEND_DIR}
                    echo [OK] Frontend code: ${env.KNOWLEDGE_HUB_FRONTEND_DIR}
                    echo No checkout/pull is performed - the code on the machine is deployed as-is.
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Stop Backend Service') {
            steps {
                bat """
                    @echo off
                    sc query "${env.KNOWLEDGE_HUB_SERVICE_NAME}" >nul 2>&1
                    if %ERRORLEVEL% EQU 0 (
                        echo Stopping ${env.KNOWLEDGE_HUB_SERVICE_NAME}...
                        net stop "${env.KNOWLEDGE_HUB_SERVICE_NAME}" 2>nul || echo Service was not running
                        timeout /t 3 /nobreak >nul
                    ) else (
                        echo Service ${env.KNOWLEDGE_HUB_SERVICE_NAME} does not exist yet - skipping stop.
                    )
                    echo NOTE: only the Knowledge Hub service is stopped. Other Python
                    echo services (eg ATMS-Python-AI) are deliberately NOT touched.
                    rem sc query above leaves ERRORLEVEL=1060 when the service does
                    rem not exist, and ECHO/IF do not reset it - without this line
                    rem the bat step would end with 1060 and Jenkins would fail
                    rem this stage even though skipping is the correct outcome.
                    exit /b 0
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Create Virtual Environment') {
            steps {
                bat """
                    @echo off
                    setlocal

                    echo ========================================
                    echo Creating virtual environment (Python 3.12)
                    echo ========================================

                    if not exist "${env.KNOWLEDGE_HUB_PYTHON_EXE}" (
                        echo ERROR: Python 3.12 not found at ${env.KNOWLEDGE_HUB_PYTHON_EXE}
                        echo Run Ansible provisioning first ^(python312 role^).
                        exit /b 1
                    )

                    cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"

                    rem An existing .venv is only reusable if it is Python 3.12.
                    rem A venv created with the system python (3.11) makes
                    rem "pip install -e ." fail with:
                    rem   Package 'qasip-hub' requires a different Python: 3.11.x not in '>=3.12'
                    if exist ".venv\\Scripts\\python.exe" (
                        ".venv\\Scripts\\python.exe" --version > "%TEMP%\\kh_venv_version.txt" 2>&1
                        findstr /C:"Python 3.12" "%TEMP%\\kh_venv_version.txt" >nul
                        if errorlevel 1 (
                            echo Existing .venv is NOT Python 3.12:
                            type "%TEMP%\\kh_venv_version.txt"
                            echo Deleting it and recreating with Python 3.12...
                            rmdir /S /Q ".venv"
                            if exist ".venv" (
                                echo ERROR: Failed to delete the old .venv - is it in use by a running process?
                                exit /b 1
                            )
                        )
                    )

                    if not exist ".venv\\Scripts\\python.exe" (
                        echo python -m venv .venv
                        "${env.KNOWLEDGE_HUB_PYTHON_EXE}" -m venv .venv
                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Failed to create venv
                            exit /b 1
                        )
                    ) else (
                        echo Virtual environment already exists ^(Python 3.12^) - reusing it.
                    )

                    call .venv\\Scripts\\activate.bat
                    python --version
                    python -c "import sys; assert sys.version_info[:2]==(3,12), 'venv Python is not 3.12: '+sys.version"
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: venv Python version check failed
                        exit /b 1
                    )
                    echo Virtual environment ready: %VIRTUAL_ENV%
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Setup Backend Environment') {
            steps {
                bat """
                    @echo off
                    setlocal

                    echo ========================================
                    echo Installing Knowledge Hub backend
                    echo ========================================

                    cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                    call .venv\\Scripts\\activate.bat

                    python --version
                    python -c "import sys; assert sys.version_info[:2]==(3,12), 'venv Python is not 3.12: '+sys.version"
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: This stage must run in the Python 3.12 venv - qasip-hub requires Python ^>=3.12
                        exit /b 1
                    )
                    rem Use python -m pip for the self-upgrade: pip.exe cannot
                    rem replace itself while running on Windows ("To modify
                    rem pip, please run ... python.exe -m pip install ...").
                    python -m pip install --upgrade pip
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: pip upgrade failed
                        exit /b 1
                    )

                    echo Installing Knowledge Hub backend ^(pip install -e .^)...
                    pip install -e .
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: pip install -e . failed
                        exit /b 1
                    )

                    echo Backend environment ready.
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Install Adapters') {
            steps {
                bat """
                    @echo off

                    echo ========================================
                    echo Installing adapters into the virtual environment
                    echo ========================================

                    cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                    call .venv\\Scripts\\activate.bat

                    cd /d "${env.KNOWLEDGE_HUB_CODE_DIR}"

                    pip install -e .\\Project_Brain
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to install Project_Brain adapter
                        exit /b 1
                    )

                    pip install -e .\\Application_Brain
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to install Application_Brain adapter
                        exit /b 1
                    )

                    pip install -e .\\Code_Brain
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to install Code_Brain adapter
                        exit /b 1
                    )

                    echo Adapters installed. The Hub discovers them via entry
                    echo points at boot - the service restart below picks them up.
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Generate Secret Key') {
            steps {
                script {
                    bat """
                        @echo off

                        echo ========================================
                        echo Generating QASIP_HUB_SECRET_KEY (Fernet)
                        echo ========================================

                        cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                        call .venv\\Scripts\\activate.bat

                        rem The Fernet key generation needs the cryptography package.
                        python -c "import cryptography" 2>nul
                        if %ERRORLEVEL% NEQ 0 (
                            echo Installing cryptography for key generation...
                            pip install cryptography
                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to install cryptography
                                exit /b 1
                            )
                        )

                        rem Generate ONCE and reuse on every redeploy - a new key
                        rem would make data encrypted with the old key unreadable.
                        if exist ".qasip_hub_secret_key" (
                            echo Existing secret key found - reusing it.
                        ) else (
                            echo Generating a new secret key...
                            python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" > ".qasip_hub_secret_key"
                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Secret key generation failed
                                exit /b 1
                            )
                        )

                        copy /Y ".qasip_hub_secret_key" "%WORKSPACE%\\kh_secret_key.txt" >nul
                        echo Secret key ready (value is not printed to the log).
                    """
                    env.GENERATED_SECRET_KEY = readFile('kh_secret_key.txt').trim()
                    if (!env.GENERATED_SECRET_KEY) {
                        error 'Generated secret key is empty - see Generate Secret Key stage log'
                    }
                    echo 'QASIP_HUB_SECRET_KEY loaded for this pipeline execution (masked, not printed).'
                }
            }
        }

        // ------------------------------------------------------------------
        stage('Verify Adapters') {
            steps {
                bat """
                    @echo off
                    cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                    call .venv\\Scripts\\activate.bat

                    python -c "from importlib.metadata import entry_points; print([e.name for e in entry_points(group='qasip_hub.adapters')])" > "%TEMP%\\kh_adapters.txt" 2>&1
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Adapter verification command failed:
                        type "%TEMP%\\kh_adapters.txt"
                        exit /b 1
                    )

                    type "%TEMP%\\kh_adapters.txt"
                    findstr /C:"[]" "%TEMP%\\kh_adapters.txt" >nul
                    if %ERRORLEVEL% EQU 0 (
                        echo ERROR: No qasip_hub.adapters entry points found - adapters are not installed correctly.
                        exit /b 1
                    )
                    echo Adapters verified.
                    rem findstr above returns ERRORLEVEL=1 when "[]" is NOT found
                    rem (the success case) and ECHO does not reset it - end the
                    rem bat step explicitly with success.
                    exit /b 0
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Apply Database Migrations') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'knowledgehub-db-credentials',
                        usernameVariable: 'KH_DB_USER',
                        passwordVariable: 'KH_DB_PASSWORD'
                    ),
                    string(
                        credentialsId: 'knowledgehub-openai-api-key',
                        variable: 'KH_LLM_API_KEY'
                    ),
                    string(
                        credentialsId: 'knowledgehub-qdrant-api-key',
                        variable: 'QASIP_HUB_QDRANT_API_KEY'
                    )
                ]) {
                    bat """
                        @echo off

                        echo ========================================
                        echo Applying database migrations (alembic)
                        echo ========================================

                        set "QASIP_HUB_DATABASE_URL=postgresql://%KH_DB_USER%:%KH_DB_PASSWORD%@${env.KNOWLEDGE_HUB_HOSTNAME}:5433/qasip_hub"
                        set "QASIP_HUB_SECRET_KEY=%GENERATED_SECRET_KEY%"
                        if "${env.QASIP_HUB_LLM_PROVIDER}" == "azure_openai" (
                            set "QASIP_HUB_AZURE_OPENAI_API_KEY=%KH_LLM_API_KEY%"
                        ) else (
                            set "QASIP_HUB_OPENAI_API_KEY=%KH_LLM_API_KEY%"
                        )

                        cd /d "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                        call .venv\\Scripts\\activate.bat

                        alembic upgrade heads
                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: alembic upgrade heads failed
                            exit /b 1
                        )

                        echo Migrations applied successfully.
                    """
                }
            }
        }

        // ------------------------------------------------------------------
        stage('Configure Backend Service (NSSM)') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'knowledgehub-db-credentials',
                        usernameVariable: 'KH_DB_USER',
                        passwordVariable: 'KH_DB_PASSWORD'
                    ),
                    string(
                        credentialsId: 'knowledgehub-openai-api-key',
                        variable: 'KH_LLM_API_KEY'
                    ),
                    string(
                        credentialsId: 'knowledgehub-qdrant-api-key',
                        variable: 'QASIP_HUB_QDRANT_API_KEY'
                    )
                ]) {
                    bat """
                        @echo off
                        setlocal EnableDelayedExpansion

                        echo ========================================
                        echo Configuring ${env.KNOWLEDGE_HUB_SERVICE_NAME} service
                        echo ========================================

                        if not exist "${env.KNOWLEDGE_HUB_LOG_DIR}" mkdir "${env.KNOWLEDGE_HUB_LOG_DIR}"

                        sc query "${env.KNOWLEDGE_HUB_SERVICE_NAME}" >nul 2>&1
                        if !ERRORLEVEL! NEQ 0 (
                            echo Creating NSSM service...
                            nssm install "${env.KNOWLEDGE_HUB_SERVICE_NAME}" "${env.KNOWLEDGE_HUB_VENV_DIR}\\Scripts\\uvicorn.exe"
                            if !ERRORLEVEL! NEQ 0 (
                                echo ERROR: Failed to create service - is NSSM installed?
                                exit /b 1
                            )
                        )

                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" Application "${env.KNOWLEDGE_HUB_VENV_DIR}\\Scripts\\uvicorn.exe"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppDirectory "${env.KNOWLEDGE_HUB_BACKEND_DIR}"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppParameters "qasip_hub.main:app --host ${env.QASIP_HUB_HOST} --port ${env.QASIP_HUB_PORT} --workers 2"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" DisplayName "QASIP Knowledge Hub Backend"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" Description "Knowledge Hub backend (uvicorn qasip_hub.main:app, port ${env.QASIP_HUB_PORT})"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppStdout "${env.KNOWLEDGE_HUB_LOG_DIR}\\stdout.log"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppStderr "${env.KNOWLEDGE_HUB_LOG_DIR}\\stderr.log"
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppRotateFiles 1
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppRotateBytes 10485760
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" Start SERVICE_AUTO_START
                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppExit Default Restart

                        echo Setting QASIP_HUB_* environment for the service...

                        set "KH_DB_URL=postgresql://%KH_DB_USER%:%KH_DB_PASSWORD%@${env.KNOWLEDGE_HUB_HOSTNAME}:5433/qasip_hub"
                        if "${env.QASIP_HUB_LLM_PROVIDER}" == "azure_openai" (
                            set "KH_LLM_ENV=QASIP_HUB_AZURE_OPENAI_API_KEY=%KH_LLM_API_KEY%"
                        ) else (
                            set "KH_LLM_ENV=QASIP_HUB_OPENAI_API_KEY=%KH_LLM_API_KEY%"
                        )

                        nssm set "${env.KNOWLEDGE_HUB_SERVICE_NAME}" AppEnvironmentExtra ^
                            "QASIP_HUB_DATABASE_URL=!KH_DB_URL!" ^
                            "QASIP_HUB_HOST=${env.QASIP_HUB_HOST}" ^
                            "QASIP_HUB_PORT=${env.QASIP_HUB_PORT}" ^
                            "QASIP_HUB_RELOAD=${env.QASIP_HUB_RELOAD}" ^
                            "QASIP_HUB_CORS_ORIGINS=${env.QASIP_HUB_CORS_ORIGINS}" ^
                            "QASIP_HUB_PUBLIC_URL=${env.QASIP_HUB_PUBLIC_URL}" ^
                            "QASIP_HUB_SECRET_KEY=%GENERATED_SECRET_KEY%" ^
                            "QASIP_HUB_LLM_PROVIDER=${env.QASIP_HUB_LLM_PROVIDER}" ^
                            "!KH_LLM_ENV!" ^
                            "QASIP_HUB_OPENAI_MODEL=${env.QASIP_HUB_OPENAI_MODEL}" ^
                            "QASIP_HUB_AZURE_OPENAI_ENDPOINT=${env.QASIP_HUB_AZURE_OPENAI_ENDPOINT}" ^
                            "QASIP_HUB_AZURE_OPENAI_API_VERSION=${env.QASIP_HUB_AZURE_OPENAI_API_VERSION}" ^
                            "QASIP_HUB_AZURE_OPENAI_DEPLOYMENT=${env.QASIP_HUB_AZURE_OPENAI_DEPLOYMENT}" ^
                            "QASIP_HUB_EMBEDDING_PROVIDER=${env.QASIP_HUB_EMBEDDING_PROVIDER}" ^
                            "QASIP_HUB_LOCAL_EMBEDDING_MODEL=${env.QASIP_HUB_LOCAL_EMBEDDING_MODEL}" ^
                            "QASIP_HUB_VECTOR_BACKEND=${env.QASIP_HUB_VECTOR_BACKEND}" ^
                            "QASIP_HUB_QDRANT_URL=${env.QASIP_HUB_QDRANT_URL}" ^
                            "QASIP_HUB_QDRANT_API_KEY=%QASIP_HUB_QDRANT_API_KEY%" ^
                            "QASIP_HUB_QDRANT_COLLECTION=${env.QASIP_HUB_QDRANT_COLLECTION}" ^
                            "QASIP_HUB_LOG_LEVEL=${env.QASIP_HUB_LOG_LEVEL}" ^
                            "QASIP_HUB_AUDIT_ENABLED=${env.QASIP_HUB_AUDIT_ENABLED}"

                        if !ERRORLEVEL! NEQ 0 (
                            echo ERROR: Failed to set service environment
                            exit /b 1
                        )

                        echo Service configured. Starting it in the next stage.
                    """
                }
            }
        }

        // ------------------------------------------------------------------
        stage('Start Backend & Verify Health') {
            steps {
                bat """
                    @echo off
                    setlocal EnableDelayedExpansion

                    echo Starting ${env.KNOWLEDGE_HUB_SERVICE_NAME}...
                    net start "${env.KNOWLEDGE_HUB_SERVICE_NAME}"
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to start ${env.KNOWLEDGE_HUB_SERVICE_NAME}
                        echo ---- last backend stderr log ----
                        type "${env.KNOWLEDGE_HUB_LOG_DIR}\\stderr.log" 2>nul
                        exit /b 1
                    )

                    echo Waiting for backend health...
                    set KH_HEALTHY=0
                    for /l %%i in (1,1,30) do (
                        if !KH_HEALTHY! EQU 0 (
                            curl.exe --fail --silent http://localhost:${env.QASIP_HUB_PORT}/health >nul 2>&1
                            if !ERRORLEVEL! EQU 0 (
                                set KH_HEALTHY=1
                                echo Backend is healthy ^(attempt %%i^).
                            ) else (
                                timeout /t 5 /nobreak >nul
                            )
                        )
                    )

                    if !KH_HEALTHY! EQU 0 (
                        echo ERROR: Backend did not become healthy on port ${env.QASIP_HUB_PORT}
                        echo ---- backend stderr log ----
                        type "${env.KNOWLEDGE_HUB_LOG_DIR}\\stderr.log" 2>nul
                        echo ---- backend stdout log ----
                        type "${env.KNOWLEDGE_HUB_LOG_DIR}\\stdout.log" 2>nul
                        exit /b 1
                    )

                    echo Checking /mcp/tools...
                    curl.exe --fail --silent http://localhost:${env.QASIP_HUB_PORT}/mcp/tools >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: /mcp/tools did not respond successfully
                        exit /b 1
                    )

                    echo Checking API domain ${env.QASIP_HUB_PUBLIC_URL} ...
                    curl.exe --fail --silent ${env.QASIP_HUB_PUBLIC_URL}/health >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: ${env.QASIP_HUB_PUBLIC_URL}/health failed - check Nginx/DNS for the hub-api domain
                        exit /b 1
                    )
                    curl.exe --fail --silent ${env.QASIP_HUB_PUBLIC_URL}/mcp/tools >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: ${env.QASIP_HUB_PUBLIC_URL}/mcp/tools failed
                        exit /b 1
                    )

                    echo Backend health verified.
                """
            }
        }

        stage('Build Frontend (Node 18)') {
            steps {
                bat """
                    @echo off

                    echo ========================================
                    echo Building Knowledge Hub admin frontend
                    echo ========================================

                    if not exist "${env.KNOWLEDGE_HUB_NODE18_DIR}\\npm.cmd" (
                        echo ERROR: Node 18 not found at ${env.KNOWLEDGE_HUB_NODE18_DIR}
                        echo Run Ansible provisioning first ^(node18 role^).
                        echo NOTE: plain node/npm on this host is Node 10 and cannot build this app.
                        exit /b 1
                    )

                    rem Node 18 first in PATH for THIS build only - Node 10 stays the system default.
                    set "PATH=${env.KNOWLEDGE_HUB_NODE18_DIR};%PATH%"
                    node -v
                    npm -v

                    if not exist "${env.KNOWLEDGE_HUB_FRONTEND_DIR}" (
                        echo ERROR: Frontend code not found at ${env.KNOWLEDGE_HUB_FRONTEND_DIR}
                        exit /b 1
                    )

                    cd /d "${env.KNOWLEDGE_HUB_FRONTEND_DIR}"

                    set "VITE_HUB_API_URL=${env.VITE_HUB_API_URL}"
                    echo VITE_HUB_API_URL=%VITE_HUB_API_URL%

                    call npm ci
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: npm ci failed
                        exit /b 1
                    )

                    call npm run typecheck
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: npm run typecheck failed
                        exit /b 1
                    )

                    call npm run build
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: npm run build failed
                        exit /b 1
                    )

                    if not exist "dist\\index.html" (
                        echo ERROR: dist\\index.html not produced by the build
                        exit /b 1
                    )

                    echo Frontend built successfully.
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Publish Frontend to Nginx') {
            steps {
                bat """
                    @echo off
                    setlocal EnableDelayedExpansion

                    echo ========================================
                    echo Publishing frontend to Nginx (subfolder only)
                    echo ========================================

                    set "KH_UI_TARGET=${env.KNOWLEDGE_HUB_NGINX_HTML_DIR}\\${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}"
                    set "KH_UI_BACKUP=${env.KNOWLEDGE_HUB_NGINX_HTML_DIR}\\${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}_backup_${BUILD_NUMBER}"

                    if not exist "${env.KNOWLEDGE_HUB_NGINX_HTML_DIR}" (
                        echo ERROR: Nginx html dir not found: ${env.KNOWLEDGE_HUB_NGINX_HTML_DIR}
                        exit /b 1
                    )

                    echo Existing Angular UI in ${env.KNOWLEDGE_HUB_NGINX_HTML_DIR} is NOT touched.
                    echo Knowledge Hub UI target: %KH_UI_TARGET%

                    if exist "%KH_UI_TARGET%" (
                        echo Backing up previous Hub UI to %KH_UI_BACKUP% ...
                        robocopy "%KH_UI_TARGET%" "%KH_UI_BACKUP%" /MIR >nul
                    )

                    if not exist "%KH_UI_TARGET%" mkdir "%KH_UI_TARGET%"

                    robocopy "${env.KNOWLEDGE_HUB_FRONTEND_DIR}\\dist" "%KH_UI_TARGET%" /MIR >nul
                    if %ERRORLEVEL% GEQ 8 (
                        echo ERROR: Failed to publish dist to %KH_UI_TARGET% ^(robocopy code %ERRORLEVEL%^)
                        exit /b 1
                    )

                    echo Published. Files:
                    dir /B "%KH_UI_TARGET%"

                    echo.
                    echo IMPORTANT - Nginx must serve this subfolder with SPA fallback.
                    echo Add ^(once, in the Nginx server block for the admin-ui domain^):
                    echo.
                    echo     location /${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}/ {
                    echo         alias ${env.KNOWLEDGE_HUB_NGINX_HTML_DIR}\\${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}\\;
                    echo         try_files \$uri \$uri/ /${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}/index.html;
                    echo     }
                    echo.
                    echo Then reload Nginx:  nginx.exe -s reload  ^(from the Nginx root dir^)
                    echo Static files need no Nginx restart; the reload is only for the location config.
                """
            }
        }

        // ------------------------------------------------------------------
        stage('Verify Deployment') {
            steps {
                bat """
                    @echo off

                    echo ========================================
                    echo Final verification
                    echo ========================================

                    sc query "${env.KNOWLEDGE_HUB_SERVICE_NAME}" | findstr "RUNNING" >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: ${env.KNOWLEDGE_HUB_SERVICE_NAME} is not RUNNING
                        exit /b 1
                    )
                    echo [OK] Backend service ${env.KNOWLEDGE_HUB_SERVICE_NAME} is RUNNING

                    curl.exe --fail --silent http://localhost:${env.QASIP_HUB_PORT}/health >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Backend /health failed
                        exit /b 1
                    )
                    echo [OK] Backend /health ^(localhost:${env.QASIP_HUB_PORT}^)

                    curl.exe --fail --silent http://localhost:${env.QASIP_HUB_PORT}/mcp/tools >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Backend /mcp/tools failed
                        exit /b 1
                    )
                    echo [OK] Backend /mcp/tools

                    curl.exe --fail --silent ${env.QASIP_HUB_CORS_ORIGINS} >nul
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Admin UI not reachable at ${env.QASIP_HUB_CORS_ORIGINS}
                        echo Check the Nginx location for /${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}/ and DNS.
                        exit /b 1
                    )
                    echo [OK] Admin UI reachable: ${env.QASIP_HUB_CORS_ORIGINS}
                    echo Manual check: open ${env.QASIP_HUB_CORS_ORIGINS} and confirm API calls go to ${env.QASIP_HUB_PUBLIC_URL}

                    echo All deployment checks passed.
                """
            }
        }
    }

    post {

        success {
            echo """
            ====================================================
            KNOWLEDGE HUB DEPLOYMENT SUCCESSFUL
            ====================================================

            Target Machine  : ${params.PROJECT_TARGET_MACHINE}
            Backend Service : ${env.KNOWLEDGE_HUB_SERVICE_NAME} (port ${env.QASIP_HUB_PORT})
            Backend Health  : http://localhost:${env.QASIP_HUB_PORT}/health
            API Domain      : ${env.QASIP_HUB_PUBLIC_URL}
            Admin UI Domain : ${env.QASIP_HUB_CORS_ORIGINS} (path: /${env.KNOWLEDGE_HUB_ADMIN_UI_PATH}/)

            ====================================================
            """
        }

        failure {
            echo """
            ====================================================
            KNOWLEDGE HUB DEPLOYMENT FAILED
            ====================================================

            Target Machine : ${params.PROJECT_TARGET_MACHINE}

            Check the Jenkins console log above for the failing stage.
            Backend logs on the target:
              ${env.KNOWLEDGE_HUB_LOG_DIR}\\stdout.log
              ${env.KNOWLEDGE_HUB_LOG_DIR}\\stderr.log

            ====================================================
            """
        }
    }
}
