/*
 * Jenkinsfile-build-macos  (QASIP-Build-Mac)
 * ============================================================================
 * macOS counterpart of Jenkinsfile-build-windows (QASIP-Build-Windows).
 * Builds the same four QASIP components on a MacBook Jenkins agent and
 * uploads the same artifacts to Nexus, so QASIP-Deploy-Mac can deploy
 * them and the app can be opened in Safari exactly like on Windows.
 *
 * macOS-specific differences vs the Windows version:
 *   - Runs on a macOS Jenkins agent: `sh` steps (zsh/bash), no `bat`,
 *     no PowerShell, no Windows paths/services.
 *   - Paths live under the agent user's home: ~/QASIP/... and
 *     ~/<project>-code (no D:\ drive, no C:\Windows\Scripts).
 *   - Tools come from Homebrew / system installs and are located at
 *     runtime (Apple Silicon: /opt/homebrew, Intel: /usr/local).
 *   - BSD userland: `sed -i ''`, no `taskkill`/`net stop` (deploy side
 *     uses pid files + launchd-friendly scripts instead of NSSM).
 *   - Nexus artifact path uses /macos/ instead of /windows/ so Mac and
 *     Windows builds of the same version never overwrite each other.
 * ============================================================================
 */
pipeline {

    agent {
        label params.PROJECT_TARGET_MACHINE.toLowerCase()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    parameters {

        string(
            name: 'PROJECT_TARGET_MACHINE',
            defaultValue: '',
            description: 'Jenkins project agent label where this pipeline will run (format: project-env-ip, eg: copper-dev-10.10.3.150). For Mac, this must be the label of the MacBook agent.'
        )

        string(
            name: 'PROJECT_BRANCH',
            defaultValue: '',
            description: 'Project source code branch to checkout for build/deployment eg: qasip_devops'
        )
        string(
            name: 'NOTIFICATION_EMAILS',
            defaultValue: '',
            description: 'Comma-separated email addresses (example: user1@qasource.com, user2@qasource.com)'
        )
    }
    environment {
        PROJECT_NAME         = "${params.PROJECT_TARGET_MACHINE.split('-')[0]}"
        NEXUS_URL            = 'http://10.10.6.118:8081'
        NEXUS_CREDENTIALS_ID = 'nexus-credentials'
        NEXUS_REPO           = 'atms-modules'
        VERSION        = '1.0.0'
        BUILD_NUMBER   = "${env.BUILD_NUMBER}"
        WAR_VERSION    = "1.0.0-${env.BUILD_NUMBER}"
        DIST_VERSION   = "1.0.0-${env.BUILD_NUMBER}"

        // macOS layout (mirrors D:\<project>-code and D:\QASIP on Windows)
        QASIP_HOME      = "${env.HOME}/QASIP"
        BASE_DEPLOY_DIR = "${env.HOME}/deploys"
        DEPLOY_DIR      = "${env.HOME}/${PROJECT_NAME}-code"
        REPO_BASE_DIR   = "${env.HOME}/${PROJECT_NAME}-code"
        SCRIPT_DIR      = "${env.HOME}/QASIP/Scripts"

        JAVA_REPO   = 'git@10.10.1.68:andes/atms-app.git'
        NODE_REPO   = 'git@10.10.1.68:andes/atms-node-microservice.git'
        UI_REPO     = 'git@10.10.1.68:andes/atms-ui.git'
        PYTHON_REPO = 'git@10.10.1.68:AI/AI.git'

        GIT_CREDENTIALS_ID = 'jenkins-gitlab-118'

        GRADLE_PROJECT_DIR = "${DEPLOY_DIR}/atms-app"
        WAR_BUILD_DIR      = "${DEPLOY_DIR}/atms-app/atms-web/build/libs"

        SPRING_PROFILE = 'local'
        ANSIBLE_OS = "macos"
    }
    stages {

        stage('Validate Parameters') {
            steps {
                script {

                    env.AGENT_LABEL = params.PROJECT_TARGET_MACHINE?.trim()?.toLowerCase()
                    env.BRANCH_NAME = params.PROJECT_BRANCH?.trim()

                    def missing = []
                    def formatErrors = []
                    def notificationEmails = params.NOTIFICATION_EMAILS?.trim()?.toLowerCase()
                    if (!env.AGENT_LABEL) missing << "PROJECT_TARGET_MACHINE"
                    if (!env.BRANCH_NAME) missing << "PROJECT_BRANCH"
                    if (!notificationEmails) {
                        missing << "NOTIFICATION_EMAILS"
                    }

                    // Validate NOTIFICATION_EMAILS
                    if (notificationEmails) {

                        def emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/
                        def emailList = notificationEmails
                                            .split(',')
                                            .collect { it.trim() }
                                            .findAll { it }

                        if (emailList.size() != emailList.unique().size()) {
                            formatErrors << "Duplicate email addresses found in NOTIFICATION_EMAILS"
                        }

                        for (email in emailList) {
                            if (!(email ==~ emailRegex)) {
                                formatErrors << "Invalid email format detected: ${email}"
                            }
                        }
                    }

                    if (missing || formatErrors) {
                        error """
BUILD FAILED ❌
Missing required parameters:
${missing.join('\n')}
${formatErrors ? "Format Errors:\n${formatErrors.join('\n')}\n" : ""}

Expected email format:
user1@qasource.com, user2@qasource.com
"""
                    }

                    echo "Parameters validated successfully ✅"
                    echo "Agent → ${env.AGENT_LABEL}"
                    echo "Branch → ${env.BRANCH_NAME}"
                    echo "Notification Emails → ${notificationEmails}"
                }
                sh '''
                    echo "========================================"
                    echo "macOS agent check"
                    echo "========================================"
                    sw_vers
                    uname -m
                    echo "Homebrew prefix: $(brew --prefix 2>/dev/null || echo 'brew not found in PATH')"
                '''
            }
        }

        // =============================================
        // STAGE 0: Fetch SSH keys from Nexus for Git
        // (Windows: C:\\Windows\\System32\\config\\systemprofile\\.ssh
        //  Mac: the agent user's ~/.ssh with 700/600 permissions)
        // =============================================
        stage('Setup SSH Keys from Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''
                        set -e
                        echo "========================================"
                        echo "Setting up SSH Keys from Nexus"
                        echo "========================================"

                        mkdir -p "$HOME/.ssh"
                        chmod 700 "$HOME/.ssh"

                        echo "Downloading SSH key files from Nexus..."
                        python3 - <<'PYEOF'
import base64, json, os, urllib.request

nexus = os.environ['NEXUS_URL']
repo = os.environ['NEXUS_REPO']
auth = base64.b64encode(f"{os.environ['NEXUS_USER']}:{os.environ['NEXUS_PASSWORD']}".encode()).decode()
headers = {'Authorization': f'Basic {auth}'}
ssh_dir = os.path.expanduser('~/.ssh')

urls, token = [], None
while True:
    uri = f"{nexus}/service/rest/v1/components?repository={repo}"
    if token:
        uri += f"&continuationToken={token}"
    req = urllib.request.Request(uri, headers=headers)
    with urllib.request.urlopen(req) as r:
        data = json.load(r)
    for item in data.get('items', []):
        for asset in item.get('assets', []):
            if 'ssh-key' in asset.get('downloadUrl', ''):
                urls.append(asset['downloadUrl'])
    token = data.get('continuationToken')
    if not token:
        break

print(f"Found {len(urls)} SSH key file(s)")
for url in urls:
    name = url.rstrip('/').split('/')[-1]
    out = os.path.join(ssh_dir, name)
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as r, open(out, 'wb') as f:
        f.write(r.read())
    os.chmod(out, 0o600)
    print(f"Downloaded: {name}")
print("SSH keys setup complete.")
PYEOF

                        echo
                        echo "SSH key files in ~/.ssh:"
                        ls -1 "$HOME/.ssh"
                        echo "========================================"
                    '''
                }
            }
        }

        stage('Download Common Scripts from Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    sh '''
                        set -e
                        echo "========================================"
                        echo "Preparing Scripts Directory"
                        echo "========================================"

                        # Windows uses C:\\Windows\\Scripts; Mac uses ~/QASIP/Scripts
                        rm -rf "$SCRIPT_DIR"
                        mkdir -p "$SCRIPT_DIR"

                        echo "Downloading scripts from Nexus..."
                        python3 - <<'PYEOF'
import base64, json, os, re, urllib.request

nexus = os.environ['NEXUS_URL']
repo = os.environ['NEXUS_REPO']
auth = base64.b64encode(f"{os.environ['NEXUS_USER']}:{os.environ['NEXUS_PASSWORD']}".encode()).decode()
headers = {'Authorization': f'Basic {auth}'}
download_dir = os.environ['SCRIPT_DIR']

urls, token = [], None
while True:
    uri = f"{nexus}/service/rest/v1/components?repository={repo}"
    if token:
        uri += f"&continuationToken={token}"
    req = urllib.request.Request(uri, headers=headers)
    with urllib.request.urlopen(req) as r:
        data = json.load(r)
    for item in data.get('items', []):
        for asset in item.get('assets', []):
            p = asset.get('path', '')
            if 'script' in p and re.search(r'\\.(js|json)$', p):
                urls.append(asset['downloadUrl'])
    token = data.get('continuationToken')
    if not token:
        break

print(f"Found {len(urls)} file(s)")
if not urls:
    raise SystemExit('No scripts found in repo')
for url in urls:
    name = url.rstrip('/').split('/')[-1]
    out = os.path.join(download_dir, name)
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req) as r, open(out, 'wb') as f:
        f.write(r.read())
    print(f"Downloading: {name}")
print("Scripts download complete.")
PYEOF

                        echo
                        echo "Downloaded files:"
                        ls -1 "$SCRIPT_DIR"
                        echo "========================================"
                    '''
                }
            }
        }

        stage('Download NPM Packages') {
            steps {
                sh '''
                    set -e
                    echo "========================================"
                    echo "Installing Node Packages"
                    echo "========================================"

                    if [ ! -f "$SCRIPT_DIR/package.json" ]; then
                        echo "ERROR: package.json not found in $SCRIPT_DIR"
                        exit 1
                    fi

                    cd "$SCRIPT_DIR"
                    npm install

                    echo "========================================"
                    echo "NPM Install Completed Successfully"
                    echo "========================================"
                '''
            }
        }

        // =============================================
        // STAGE 1: Clone latest code from all 4 repos
        // =============================================
        stage('Checkout Code from Repositories') {
            steps {
                script {
                    // Generate date-based release version
                    env.BUILD_DATE = new Date().format('dd-MM-yyyy')
                    env.RELEASE_VERSION = "${env.BUILD_DATE}-v${VERSION}-${env.BUILD_NUMBER}"

                    echo "========================================="
                    echo "Checking out code from 4 repositories"
                    echo "Branch: ${params.PROJECT_BRANCH}"
                    echo "Release Version: ${env.RELEASE_VERSION}"
                    echo "Nexus Path: ${PROJECT_NAME}/${env.RELEASE_VERSION}/"
                    echo "========================================="

                    sh "mkdir -p '${REPO_BASE_DIR}'"

                    def repositories = [
                        [name: 'AI-Python', url: 'git@10.10.1.68:AI/AI.git', type: 'Python'],
                        [name: 'atms-app', url: 'git@10.10.1.68:andes/atms-app.git', type: 'Java'],
                        [name: 'atms-node-microservice', url: 'git@10.10.1.68:andes/atms-node-microservice.git', type: 'Node.js'],
                        [name: 'atms-ui', url: 'git@10.10.1.68:andes/atms-ui.git', type: 'UI']
                    ]

                    repositories.each { repo ->
                        def branchName = repo.branch ?: params.PROJECT_BRANCH
                        echo "Checking out: ${repo.name} (${repo.type}) - Branch: ${branchName}"
                        dir("${REPO_BASE_DIR}/${repo.name}") {
                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: "*/${branchName}"]],
                                userRemoteConfigs: [[
                                    url: repo.url,
                                    credentialsId: env.GIT_CREDENTIALS_ID
                                ]],
                                extensions: [[
                                    $class: 'CloneOption',
                                    shallow: true,
                                    depth: 1
                                ]]
                            ])
                        }
                        echo "${repo.name} checked out successfully from branch: ${branchName}"
                    }

                    sh """
                        echo "========================================"
                        echo "Cleaning up @tmp folders"
                        echo "========================================"
                        find "${REPO_BASE_DIR}" -maxdepth 1 -name '*@tmp' -type d -exec rm -rf {} + 2>/dev/null || true
                        echo "@tmp cleanup done."

                        echo
                        echo "========================================"
                        echo "Repository Checkout Summary"
                        echo "========================================"
                        echo "Branch: ${params.PROJECT_BRANCH}"
                        echo "Location: ${REPO_BASE_DIR}"
                        echo
                        ls -1 "${REPO_BASE_DIR}"
                        echo
                        echo "========================================"
                    """
                }
            }
        }

        // =============================================
        // STAGE 2: Install Node dependencies via npm
        // =============================================
        stage('Install Node Dependencies') {
            steps {
                sh """
                    set -e
                    echo "========================================"
                    echo "Installing Node dependencies for atms-node-microservice"
                    echo "========================================"

                    cd "${REPO_BASE_DIR}/atms-node-microservice"

                    echo "Running npm install..."
                    npm install

                    if [ ! -d node_modules ]; then
                        echo "ERROR: node_modules folder not found after npm install"
                        exit 1
                    fi

                    echo "npm install completed successfully."
                """
            }
        }

        // =============================================
        // STAGE 3: Prepare configs and inject credentials
        //          for Python AI and Java atms-app
        // =============================================
        stage('Prepare Configs and Inject Credentials') {
            steps {
                // Step 1: Rename .env.example to .env
                sh """
                    set -e
                    echo "========================================"
                    echo "Renaming .env.example to .env"
                    echo "========================================"

                    cd "${REPO_BASE_DIR}/AI-Python/test_script_generator"

                    if [ -f .env.example ]; then
                        [ -f .env ] && echo ".env already exists, replacing with .env.example..."
                        mv -f .env.example .env
                        echo ".env.example renamed to .env successfully"
                    else
                        echo "WARNING: .env.example not found in AI-Python/test_script_generator"
                        exit 1
                    fi
                """

                // Step 2: Inject Python credentials into .env
                withCredentials([
                    usernamePassword(
                        credentialsId: 'python-db-credentials',
                        usernameVariable: 'COUCH_USER',
                        passwordVariable: 'COUCH_PASS'
                    ),
                    string(
                        credentialsId: 'openai-api-key',
                        variable: 'OPENAI_KEY'
                    )
                ]) {
                    sh '''
                        set -e
                        echo "========================================"
                        echo "Injecting Python AI credentials into .env"
                        echo "========================================"

                        ENV_FILE="$REPO_BASE_DIR/AI-Python/test_script_generator/.env"
                        [ -f "$ENV_FILE" ] || { echo "ERROR: .env file not found at $ENV_FILE"; exit 1; }

                        echo "Updating COUCH_DB_USER, COUCH_DB_PASSWORD, and OPENAI_API_KEY..."
                        python3 - <<'PYEOF'
import os, re
path = os.path.join(os.environ['REPO_BASE_DIR'], 'AI-Python/test_script_generator/.env')
content = open(path).read()
content = re.sub(r'COUCH_DB_USER\\s*=\\s*".*?"', f'COUCH_DB_USER = "{os.environ["COUCH_USER"]}"', content)
content = re.sub(r'COUCH_DB_PASSWORD\\s*=\\s*".*?"', f'COUCH_DB_PASSWORD = "{os.environ["COUCH_PASS"]}"', content)
content = re.sub(r'OPENAI_API_KEY\\s*=.*', f'OPENAI_API_KEY={os.environ["OPENAI_KEY"]}', content)
open(path, 'w').write(content)
print("Python AI credentials injected successfully.")
PYEOF
                    '''
                }

                // Step 3: Inject Java DB credentials into settings-local.properties
                withCredentials([
                    usernamePassword(
                        credentialsId: 'java-db-credentials',
                        usernameVariable: 'JDBC_USER',
                        passwordVariable: 'JDBC_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        echo "========================================"
                        echo "Injecting Java DB credentials into settings-local.properties"
                        echo "========================================"

                        PROPS_FILE="$REPO_BASE_DIR/atms-app/atms-web/src/main/resources/settings-local.properties"
                        [ -f "$PROPS_FILE" ] || { echo "ERROR: settings-local.properties not found at $PROPS_FILE"; exit 1; }

                        echo "Updating jdbc.username and jdbc.password..."
                        python3 - <<'PYEOF'
import os, re
path = os.path.join(os.environ['REPO_BASE_DIR'], 'atms-app/atms-web/src/main/resources/settings-local.properties')
content = open(path).read()
content = re.sub(r'jdbc\\.username\\s*=.*', f'jdbc.username = {os.environ["JDBC_USER"]}', content)
content = re.sub(r'jdbc\\.password\\s*=.*', f'jdbc.password = {os.environ["JDBC_PASS"]}', content)
open(path, 'w').write(content)
print("Java DB credentials injected successfully.")
PYEOF
                    '''
                }
            }
        }

        // =============================================
        // STAGE 4: Zip and upload source code to Nexus
        //          (node-microservice includes node_modules)
        // =============================================
        stage('Upload Source Code to Nexus') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        sh """
                            set -e
                            echo "========================================"
                            echo "Zipping atms-node-microservice (with node_modules)"
                            echo "========================================"

                            cd "${REPO_BASE_DIR}/atms-node-microservice"

                            echo "Creating archive: atms-node-microservice.zip"
                            rm -f "${REPO_BASE_DIR}/atms-node-microservice.zip"
                            cd "${REPO_BASE_DIR}" && zip -qr atms-node-microservice.zip atms-node-microservice

                            echo "Uploading atms-node-microservice to Nexus..."
                            HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" -u "\$NEXUS_USER:\$NEXUS_PASSWORD" \\
                              --upload-file "${REPO_BASE_DIR}/atms-node-microservice.zip" \\
                              "${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-node-microservice/atms-node-microservice.zip")

                            echo "HTTP Response Code: \$HTTP_CODE"
                            if [ "\$HTTP_CODE" = "201" ]; then
                                echo "atms-node-microservice uploaded successfully!"
                                echo "Location: ${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-node-microservice/"
                            else
                                echo "ERROR: Upload failed with HTTP code: \$HTTP_CODE"
                                exit 1
                            fi

                            rm -f "${REPO_BASE_DIR}/atms-node-microservice.zip"
                        """

                        sh """
                            set -e
                            echo "========================================"
                            echo "Zipping AI-Python source code"
                            echo "========================================"

                            echo "Creating archive: AI-Python.zip"
                            rm -f "${REPO_BASE_DIR}/AI-Python.zip"
                            cd "${REPO_BASE_DIR}" && zip -qr AI-Python.zip AI-Python

                            echo "Uploading AI-Python source to Nexus..."
                            HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" -u "\$NEXUS_USER:\$NEXUS_PASSWORD" \\
                              --upload-file "${REPO_BASE_DIR}/AI-Python.zip" \\
                              "${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/AI-Python/AI-Python.zip")

                            echo "HTTP Response Code: \$HTTP_CODE"
                            if [ "\$HTTP_CODE" = "201" ]; then
                                echo "AI-Python source uploaded successfully!"
                                echo "Location: ${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/AI-Python/"
                            else
                                echo "ERROR: Upload failed with HTTP code: \$HTTP_CODE"
                                exit 1
                            fi

                            rm -f "${REPO_BASE_DIR}/AI-Python.zip"
                        """
                    }
                }
            }
        }

        // =============================================
        // STAGE 5: Install UI dependencies via npm & bower
        // =============================================
        stage('Install UI Dependencies') {
            steps {
                sh """
                    set -e
                    echo "========================================"
                    echo "Installing atms-ui dependencies"
                    echo "========================================"

                    cd "${REPO_BASE_DIR}/atms-ui"

                    echo "[1/3] Running npm install..."
                    npm install
                    echo "npm install completed successfully."
                    echo

                    echo "[2/3] Checking if bower is installed..."
                    if ! npx bower --version >/dev/null 2>&1; then
                        echo "bower not found, installing globally..."
                        npm install -g bower
                        echo "bower installed successfully."
                    else
                        echo "bower is already available."
                    fi
                    echo

                    echo "[3/3] Running bower install..."
                    npx bower install --allow-root
                    echo "bower install completed successfully."
                    echo
                    echo "All atms-ui dependencies installed."
                """
            }
        }

        // =============================================
        // STAGE 6: Clean old WAR files before building
        // =============================================
        stage('Clean Old Build Artifacts') {
            steps {
                sh """
                    echo "========================================"
                    echo "Cleaning Old Build Artifacts"
                    echo "========================================"

                    if [ -d "${WAR_BUILD_DIR}" ]; then
                        echo "Found existing build directory: ${WAR_BUILD_DIR}"
                        echo "Deleting old WAR files..."
                        rm -f "${WAR_BUILD_DIR}"/*.war
                        echo "Old WAR files cleaned."
                    else
                        echo "No existing build directory found. Skipping cleanup."
                    fi

                    echo "Cleanup completed successfully!"
                """
            }
        }

        // =============================================
        // STAGE 7: Build Java WAR from cloned atms-app
        // (Windows pins Gradle 2.1 + JDK 8 from fixed paths; on Mac the
        //  toolchain is located at runtime - Homebrew on Apple Silicon
        //  lives in /opt/homebrew, on Intel in /usr/local, and JDKs in
        //  /Library/Java/JavaVirtualMachines. Set JAVA_HOME/GRADLE_HOME
        //  on the agent to override the auto-detection.)
        // =============================================
        stage('Build Java Application') {
            steps {
                sh """
                    set -e
                    echo "========================================"
                    echo "Building Java Application"
                    echo "Build Number: ${BUILD_NUMBER}"
                    echo "WAR Version: ${WAR_VERSION}"
                    echo "========================================"

                    # --- Locate JAVA_HOME (prefer an existing env value) ---
                    if [ -z "\${JAVA_HOME:-}" ]; then
                        if [ -x /usr/libexec/java_home ]; then
                            JAVA_HOME=\$(/usr/libexec/java_home -v 1.8 2>/dev/null || /usr/libexec/java_home 2>/dev/null || true)
                        fi
                    fi
                    if [ -n "\${JAVA_HOME:-}" ] && [ -x "\$JAVA_HOME/bin/java" ]; then
                        export JAVA_HOME
                        export PATH="\$JAVA_HOME/bin:\$PATH"
                    fi

                    # --- Locate Gradle (prefer an existing env value) ---
                    if [ -z "\${GRADLE_HOME:-}" ]; then
                        for candidate in /opt/homebrew/opt/gradle /usr/local/opt/gradle "\$HOME/.sdkman/candidates/gradle/current"; do
                            if [ -n "\$candidate" ] && [ -x "\$candidate/bin/gradle" ]; then
                                GRADLE_HOME="\$candidate"
                                break
                            fi
                        done
                    fi
                    if [ -n "\${GRADLE_HOME:-}" ] && [ -x "\$GRADLE_HOME/bin/gradle" ]; then
                        export GRADLE_HOME
                        export PATH="\$GRADLE_HOME/bin:\$PATH"
                    fi

                    echo "JAVA_HOME=\${JAVA_HOME:-not set}"
                    echo "GRADLE_HOME=\${GRADLE_HOME:-not set}"
                    echo

                    echo "Checking Gradle version..."
                    command -v gradle >/dev/null 2>&1 || { echo "ERROR: Gradle not found (install with: brew install gradle, or set GRADLE_HOME)"; exit 1; }
                    gradle -v
                    echo

                    echo "Checking Java version..."
                    java -version
                    echo

                    echo "Navigating to project directory: ${GRADLE_PROJECT_DIR}"
                    cd "${GRADLE_PROJECT_DIR}"
                    echo "Current directory: \$PWD"
                    echo

                    if [ ! -f build.gradle ]; then
                        echo "ERROR: build.gradle not found in current directory"
                        ls -la
                        exit 1
                    fi
                    echo "Found build.gradle"
                    echo

                    echo "========================================"
                    echo "Starting Gradle Build Process"
                    echo "Running: gradle clean war -Dspring.profiles.active=${SPRING_PROFILE}"
                    echo "========================================"
                    gradle clean war -Dspring.profiles.active=${SPRING_PROFILE}

                    echo
                    echo "========================================"
                    echo "Build completed successfully!"
                    echo "========================================"
                    echo

                    if ! ls "${WAR_BUILD_DIR}"/*.war >/dev/null 2>&1; then
                        echo "ERROR: No WAR file found in ${WAR_BUILD_DIR}"
                        exit 1
                    fi

                    echo "WAR file created:"
                    ls -la "${WAR_BUILD_DIR}"/*.war
                    echo
                """
            }
        }

        // =============================================
        // STAGE 8: Upload built WAR to Nexus
        // =============================================
        stage('Upload WAR to Nexus') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        def uploadStatus = sh(script: """
                            set -e
                            echo "========================================"
                            echo "Uploading WAR to Nexus (Version: ${WAR_VERSION})"
                            echo "========================================"

                            cd "${WAR_BUILD_DIR}"

                            WAR_FILE=\$(ls *.war | head -1)
                            if [ -z "\$WAR_FILE" ]; then
                                echo "ERROR: No WAR file found"
                                exit 1
                            fi

                            echo "Found WAR file: \$WAR_FILE"
                            echo "Uploading as ROOT.war to: ${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-app/ROOT.war"
                            echo

                            HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" -u "\$NEXUS_USER:\$NEXUS_PASSWORD" \\
                              --upload-file "\$WAR_FILE" \\
                              "${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-app/ROOT.war")

                            echo "HTTP Response Code: \$HTTP_CODE"
                            if [ "\$HTTP_CODE" = "201" ]; then
                                echo "Upload successful!"
                                echo "Location: ${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-app/"
                                exit 0
                            else
                                echo "Upload failed with HTTP code: \$HTTP_CODE"
                                exit 1
                            fi
                        """, returnStatus: true)

                        if (uploadStatus != 0) {
                            error("Failed to upload WAR file to Nexus")
                        }
                    }
                }
            }
        }

        // =============================================
        // STAGE 9: Build atms-ui dist and upload to Nexus
        // =============================================
        stage('Build and Upload atms-ui dist') {
            steps {
                script {
                    sh """
                        set -e
                        echo "========================================"
                        echo "Building atms-ui dist (Version: ${DIST_VERSION})"
                        echo "========================================"

                        cd "${REPO_BASE_DIR}/atms-ui"

                        if [ -d dist ]; then
                            echo "Cleaning old dist folder..."
                            rm -rf dist
                        fi

                        echo "Installing npm dependencies..."
                        npm install

                        echo "Running gulp build..."
                        npx gulp build --api_host http://localhost:8080

                        if [ ! -d dist ]; then
                            echo "ERROR: dist folder not found after build"
                            exit 1
                        fi

                        echo "Build completed successfully!"
                    """

                    withCredentials([usernamePassword(
                        credentialsId: env.NEXUS_CREDENTIALS_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )]) {
                        def uploadDistStatus = sh(script: """
                            set -e
                            echo "========================================"
                            echo "Uploading atms-ui dist to Nexus"
                            echo "========================================"

                            cd "${REPO_BASE_DIR}/atms-ui"
                            [ -d dist ] || { echo "ERROR: dist folder not found"; exit 1; }

                            echo "Creating archive: atms-ui-dist.tar.gz"
                            tar -czf atms-ui-dist.tar.gz -C dist .

                            echo "Uploading to: ${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-ui/"

                            HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" -u "\$NEXUS_USER:\$NEXUS_PASSWORD" \\
                              --upload-file "atms-ui-dist.tar.gz" \\
                              "${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-ui/atms-ui-dist.tar.gz")

                            echo "HTTP Response Code: \$HTTP_CODE"
                            if [ "\$HTTP_CODE" = "201" ]; then
                                echo "Upload successful!"
                                echo "Location: ${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/atms-ui/"
                                rm -f atms-ui-dist.tar.gz
                                exit 0
                            else
                                echo "Upload failed with HTTP code: \$HTTP_CODE"
                                exit 1
                            fi
                        """, returnStatus: true)

                        if (uploadDistStatus != 0) {
                            error("Failed to upload atms-ui dist folder to Nexus")
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {

                    echo """
        ========================================
        BUILD SUCCESSFUL
        ========================================
        All components processed successfully:
        - Git Repos cloned from branch: ${params.PROJECT_BRANCH}
        - Release Version: ${RELEASE_VERSION}
        - Nexus Base Path: ${NEXUS_URL}/repository/${NEXUS_REPO}/${PROJECT_NAME}/macos/${RELEASE_VERSION}/
        - atms-node-microservice: uploaded (with node_modules)
        - AI-Python: uploaded
        - atms-app: ROOT.war uploaded
        - atms-ui: dist uploaded
        ========================================
        """
                def executionTime = currentBuild.durationString.replace(' and counting', '')

                sh """
                node "$SCRIPT_DIR/sendBuildEmail.js" --smtpServer=$SMTP_SERVER --smtpUser=$SMTP_USER --smtpPassword=$SMTP_PASSWORD --smtpPort=$SMTP_PORT --senderName="DevOps QASIP" --senderEmail="copper@qasource.com" --receiverEmail="${params.NOTIFICATION_EMAILS}" --projectName="$PROJECT_NAME" --branch="${params.PROJECT_BRANCH}" --buildNumber="${RELEASE_VERSION}" --osType=$ANSIBLE_OS --executionTime="${executionTime}" --status="success" --runUrl="${env.BUILD_URL}"
                """
                }
            }
        }
        failure {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {
                    echo """
        ========================================
        BUILD FAILED
        ========================================
        Please check the logs above for errors.
        ========================================
        """
                }
            }
        }
    }
}
