pipeline {
    agent {
        label params.PROJECT_TARGET_MACHINE.toLowerCase()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        NEXUS_URL            = 'http://10.10.6.118:8081'
        NEXUS_REPO           = 'atms-modules'
        NEXUS_CREDENTIALS_ID = 'nexus-credentials'
        SCRIPT_ROOT          = "${WORKSPACE}\\db-scripts"
        DB_SCRIPT_DIR        = "${WORKSPACE}\\db-scripts\\db"
        NOTIFY_SCRIPT_DIR    = "${WORKSPACE}\\db-scripts\\script"
    }

    parameters {
        string(
            name: 'PROJECT_TARGET_MACHINE',
            defaultValue: 'copper-dev-10.10.3.158',
            description: 'Jenkins Windows node label where restore should run (example: copper-dev-10.10.3.158).'
        )
        string(
            name: 'PG_USER',
            defaultValue: 'postgres',
            description: 'PostgreSQL user used by psql restore.'
        )
        password(
            name: 'PG_PASSWORD',
            defaultValue: 'Welcom3!',
            description: 'PostgreSQL password.'
        )
        string(
            name: 'COUCH_USER',
            defaultValue: 'admin',
            description: 'CouchDB admin user.'
        )
        password(
            name: 'COUCH_PASSWORD',
            defaultValue: 'Welcom3!',
            description: 'CouchDB admin password.'
        )
        string(
            name: 'RESTORE_TIMESTAMP',
            defaultValue: '',
            description: 'Optional snapshot folder name (dd-MM-yyyy-HH-build123). Leave blank to restore latest.'
        )
        string(
            name: 'NOTIFICATION_EMAILS',
            defaultValue: '',
            description: 'Comma-separated email addresses for restore notifications.'
        )
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    def missing = []
                    if (!params.PROJECT_TARGET_MACHINE?.trim()) missing << 'PROJECT_TARGET_MACHINE'
                    if (!params.NOTIFICATION_EMAILS?.trim()) missing << 'NOTIFICATION_EMAILS'
                    if (missing) {
                        error """
BUILD FAILED
Missing required parameters:
${missing.join('\n')}
"""
                    }

                    if (params.RESTORE_TIMESTAMP?.trim()) {
                        if (!(params.RESTORE_TIMESTAMP ==~ /^([0-9]{2}-[0-9]{2}-[0-9]{4}-[0-9]{2}-build[0-9]+|[0-9]{2}-[0-9]{2}-[0-9]{4}-[0-9]{6}|[0-9]{8}_[0-9]{6})$/)) {
                            error "RESTORE_TIMESTAMP must be in dd-MM-yyyy-HH-build<number> format (or legacy dd-MM-yyyy-HHmmss / yyyyMMdd_HHmmss). Provided: ${params.RESTORE_TIMESTAMP}"
                        }
                    }

                    def targetMachine = params.PROJECT_TARGET_MACHINE.trim().toLowerCase()
                    def projectName = targetMachine.tokenize('-')[0]
                    if (!projectName) {
                        error "Could not derive project name from PROJECT_TARGET_MACHINE '${targetMachine}'."
                    }

                    def emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/
                    def emailList = params.NOTIFICATION_EMAILS
                        .split(',')
                        .collect { it.trim().toLowerCase() }
                        .findAll { it }
                    def invalidEmails = emailList.findAll { !(it ==~ emailRegex) }
                    if (invalidEmails) {
                        error "Invalid NOTIFICATION_EMAILS entries: ${invalidEmails.join(', ')}"
                    }

                    env.PROJECT_NAME = projectName
                    env.NOTIFY_EMAILS = emailList.join(',')
                    env.PG_PORT = '5432'
                    env.PG_BIN_DIR = 'D:\\QASIP\\Apps\\postgres\\bin'
                    env.COUCH_HOST = 'localhost'
                    env.COUCH_PORT = '5984'
                    env.RESTORE_ROOT = "D:\\DB\\Restore\\${env.PROJECT_NAME}"
                    env.KNOWLEDGE_BASE_TARGET = 'D:\\QASIP\\Apps\\python-ai-service\\test_script_generator'
                    env.BACKUP_SOURCE_HOST = '10.10.7.171'
                    env.BACKUP_SOURCE_USER = 'qasip'
                    env.BACKUP_SOURCE_PASSWORD = 'Bebo@123'
                    env.BACKUP_SOURCE_HOST_KEY = 'ssh-ed25519 255 SHA256:gdlcbTMsdipEi0TSq7FDQRbBZYKxdpK3c40tLy3Wnj0'
                    env.BACKUP_SOURCE_ROOT = "E:/DB/backup/${env.PROJECT_NAME}"
                    echo "Resolved project name: ${env.PROJECT_NAME}"
                    echo "Resolved restore root: ${env.RESTORE_ROOT}"
                    echo "Resolved knowledge base target: ${env.KNOWLEDGE_BASE_TARGET}"
                }
                bat '''
                    @echo off
                    setlocal
                    if "%PG_PASSWORD%"=="" (
                        echo ERROR: PG_PASSWORD is required.
                        exit /b 1
                    )
                    if "%COUCH_PASSWORD%"=="" (
                        echo ERROR: COUCH_PASSWORD is required.
                        exit /b 1
                    )
                '''
            }
        }

        stage('Download DB Scripts from Nexus') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.NEXUS_CREDENTIALS_ID,
                    usernameVariable: 'NEXUS_USER',
                    passwordVariable: 'NEXUS_PASSWORD'
                )]) {
                    bat '''
                        @echo off
                        setlocal
                        echo ========================================
                        echo Downloading DB and notification scripts from Nexus
                        echo ========================================

                        if not exist "%SCRIPT_ROOT%" mkdir "%SCRIPT_ROOT%"

                        powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$headers=@{Authorization='Basic '+[Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes('%NEXUS_USER%:%NEXUS_PASSWORD%'))};$targetRoot='%SCRIPT_ROOT%';if(Test-Path $targetRoot){Get-ChildItem -Path $targetRoot -Force | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue};$token=$null;$assets=@();do{$uri='%NEXUS_URL%/service/rest/v1/components?repository=%NEXUS_REPO%';if($token){$uri+='&continuationToken='+$token};$r=Invoke-RestMethod -Uri $uri -Headers $headers;foreach($i in $r.items){foreach($a in $i.assets){$p=($a.path|Out-String).Trim();$u=($a.downloadUrl|Out-String).Trim();if((($p -like 'common/db/*') -or ($p -like '/common/db/*') -or ($p -like 'common/script/*') -or ($p -like '/common/script/*') -or ($u -match '/common/(db|script)/')) -and ($u -match '\\.(ps1|js|json)$')){$assets+=$a}}};$token=$r.continuationToken}while($token);if($assets.Count -eq 0){throw 'No DB/script files found in Nexus common path'};foreach($a in $assets){$p=($a.path|Out-String).Trim();$rel=if($p){$p -replace '^/?common/',''}else{(($a.downloadUrl -split '/repository/[^/]+/')[1] -replace '^/?common/','')};$out=Join-Path $targetRoot ($rel -replace '/','\\');$dir=Split-Path $out -Parent;if(-not(Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force | Out-Null};Invoke-WebRequest -Uri $a.downloadUrl -Headers $headers -OutFile $out -UseBasicParsing;Write-Host('Downloaded: '+$rel)};Write-Host 'Nexus script download complete.'"

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Failed to download DB scripts from Nexus
                            exit /b 1
                        )

                        if not exist "%DB_SCRIPT_DIR%\\Restore_Script.ps1" (
                            echo ERROR: Restore_Script.ps1 not found in %DB_SCRIPT_DIR%
                            exit /b 1
                        )

                        if not exist "%NOTIFY_SCRIPT_DIR%\\sendDbPipelineEmail.js" (
                            echo ERROR: sendDbPipelineEmail.js not found in %NOTIFY_SCRIPT_DIR%
                            exit /b 1
                        )
                    '''
                }
            }
        }

        stage('Install Notification Dependencies') {
            steps {
                bat '''
                    @echo off
                    setlocal
                    cd /d "%NOTIFY_SCRIPT_DIR%"
                    if not exist "node_modules\\nodemailer" (
                        call npm install --no-audit --no-fund
                    )
                '''
            }
        }

        stage('Verify Script and Tools') {
            steps {
                bat '''
                    @echo off
                    setlocal

                    set "PATH=%PG_BIN_DIR%;%PATH%"

                    if not exist "%DB_SCRIPT_DIR%\\Restore_Script.ps1" (
                        echo ERROR: Restore script not found at %DB_SCRIPT_DIR%\\Restore_Script.ps1
                        exit /b 1
                    )

                    if exist "%PG_BIN_DIR%\\psql.exe" (
                        echo Found psql at %PG_BIN_DIR%\\psql.exe
                    ) else (
                        echo ERROR: psql.exe not found at expected Ansible path %PG_BIN_DIR%\\psql.exe
                        exit /b 1
                    )

                    where psql >nul 2>&1
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: psql is not available in PATH
                        exit /b 1
                    )

                    where pscp >nul 2>&1
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: pscp is not available in PATH
                        exit /b 1
                    )

                    where plink >nul 2>&1
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: plink is not available in PATH
                        exit /b 1
                    )

                    echo Restore prechecks passed.
                '''
            }
        }

        stage('Fetch Backup From Source Server') {
            steps {
                script {
                    def effectiveTs = params.RESTORE_TIMESTAMP?.trim()
                    if (!effectiveTs) {
                        effectiveTs = powershell(
                            returnStdout: true,
                            script: '''
                                $ErrorActionPreference = "Stop"
                                $remote = "$env:BACKUP_SOURCE_USER@$env:BACKUP_SOURCE_HOST"
                                $remoteCmd = "cmd /c dir /b /ad E:\\DB\\backup\\$env:PROJECT_NAME"
                                $list = & plink -batch -pw $env:BACKUP_SOURCE_PASSWORD -hostkey $env:BACKUP_SOURCE_HOST_KEY $remote $remoteCmd
                                if ($LASTEXITCODE -ne 0) { exit 1 }
                                $candidates = $list | ForEach-Object {
                                    $name = $_.ToString().Trim()
                                    if ($name -match '^([0-9]{2}-[0-9]{2}-[0-9]{4}-[0-9]{2})-build([0-9]+)$') {
                                        [PSCustomObject]@{
                                            Name = $name
                                            Dt = [datetime]::ParseExact($matches[1], 'dd-MM-yyyy-HH', $null)
                                            Build = [int]$matches[2]
                                        }
                                    } elseif ($name -match '^[0-9]{2}-[0-9]{2}-[0-9]{4}-[0-9]{6}$') {
                                        [PSCustomObject]@{ Name = $name; Dt = [datetime]::ParseExact($name, 'dd-MM-yyyy-HHmmss', $null); Build = 0 }
                                    } elseif ($name -match '^[0-9]{8}_[0-9]{6}$') {
                                        [PSCustomObject]@{ Name = $name; Dt = [datetime]::ParseExact($name, 'yyyyMMdd_HHmmss', $null); Build = 0 }
                                    }
                                } | Where-Object { $_ } | Sort-Object @{Expression='Dt';Descending=$true}, @{Expression='Build';Descending=$true}
                                $latest = ($candidates | Select-Object -First 1).Name
                                if (-not $latest) { exit 2 }
                                Write-Output $latest
                            '''
                        ).trim()

                        if (!effectiveTs) {
                            error "Could not determine latest restore timestamp from source server ${env.BACKUP_SOURCE_HOST}"
                        }
                    }

                    env.EFFECTIVE_RESTORE_TIMESTAMP = effectiveTs
                    echo "Using restore timestamp: ${env.EFFECTIVE_RESTORE_TIMESTAMP}"
                }

                bat '''
                    @echo off
                    setlocal

                    if not exist "%RESTORE_ROOT%" mkdir "%RESTORE_ROOT%"
                    plink -batch -pw "%BACKUP_SOURCE_PASSWORD%" -hostkey "%BACKUP_SOURCE_HOST_KEY%" %BACKUP_SOURCE_USER%@%BACKUP_SOURCE_HOST% exit
                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Unable to connect to backup source %BACKUP_SOURCE_HOST% over SSH.
                        exit /b 1
                    )
                    if not exist "%RESTORE_ROOT%\\%EFFECTIVE_RESTORE_TIMESTAMP%" (
                        echo Fetching snapshot %EFFECTIVE_RESTORE_TIMESTAMP% from %BACKUP_SOURCE_HOST% ...
                        if "%BACKUP_SOURCE_USER%"=="" (
                            echo ERROR: BACKUP_SOURCE_USER is empty
                            exit /b 1
                        )
                        if "%BACKUP_SOURCE_HOST%"=="" (
                            echo ERROR: BACKUP_SOURCE_HOST is empty
                            exit /b 1
                        )

                        echo SOURCE=%BACKUP_SOURCE_USER%@%BACKUP_SOURCE_HOST%:/E:/DB/backup/%PROJECT_NAME%/%EFFECTIVE_RESTORE_TIMESTAMP%
                        echo DEST=%RESTORE_ROOT%

                        pscp -batch -pw "%BACKUP_SOURCE_PASSWORD%" -hostkey "%BACKUP_SOURCE_HOST_KEY%" -r ^
                          "%BACKUP_SOURCE_USER%@%BACKUP_SOURCE_HOST%:/E:/DB/backup/%PROJECT_NAME%/%EFFECTIVE_RESTORE_TIMESTAMP%" ^
                          "%RESTORE_ROOT%"

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Failed to fetch backup snapshot from source server
                            exit /b 1
                        )
                    ) else (
                        echo Snapshot already present locally: %RESTORE_ROOT%\\%EFFECTIVE_RESTORE_TIMESTAMP%
                    )
                '''
            }
        }

        stage('Run DB Restore') {
            steps {
                bat '''
                    @echo off
                    setlocal

                    set "PATH=%PG_BIN_DIR%;%PATH%"

                    echo ========================================
                    echo Running Restore_Script.ps1
                    echo ========================================

                    powershell -NoProfile -ExecutionPolicy Bypass -File "%DB_SCRIPT_DIR%\\Restore_Script.ps1" ^
                    -PgUser "%PG_USER%" ^
                    -PgPort %PG_PORT% ^
                    -PgPassword "%PG_PASSWORD%" ^
                    -PgBinDir "%PG_BIN_DIR%" ^
                    -CouchUser "%COUCH_USER%" ^
                    -CouchPassword "%COUCH_PASSWORD%" ^
                    -CouchHost "%COUCH_HOST%" ^
                    -CouchPort %COUCH_PORT% ^
                    -RestoreRoot "%RESTORE_ROOT%" ^
                    -RestoreTimestamp "%EFFECTIVE_RESTORE_TIMESTAMP%" ^
                    -KnowledgeBaseTarget "%KNOWLEDGE_BASE_TARGET%"

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Restore script execution failed
                        exit /b 1
                    )

                    echo Restore completed successfully.
                '''
            }
        }
    }

    post {
        success {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {
                    def executionTime = currentBuild.durationString.replace(' and counting', '')
                    def restoreRunTs = "${new Date().format('dd-MM-yyyy-HH', TimeZone.getTimeZone('Asia/Kolkata'))}-build${env.BUILD_NUMBER}"
                    bat """
                        @echo off
                        setlocal
                        node "%NOTIFY_SCRIPT_DIR%\\sendDbPipelineEmail.js" ^
                        --smtpServer="%SMTP_SERVER%" ^
                        --smtpUser="%SMTP_USER%" ^
                        --smtpPassword="%SMTP_PASSWORD%" ^
                        --smtpPort="%SMTP_PORT%" ^
                        --senderName="DevOps QASIP" ^
                        --senderEmail="copper@qasource.com" ^
                        --receiverEmail="${env.NOTIFY_EMAILS}" ^
                        --pipelineType="restore" ^
                        --projectTargetMachine="${params.PROJECT_TARGET_MACHINE}" ^
                        --projectName="${env.PROJECT_NAME}" ^
                        --status="success" ^
                        --executionTime="${executionTime}" ^
                        --buildNumber="${restoreRunTs}"
                    """
                }
            }
            echo "DB restore pipeline completed successfully."
        }
        failure {
            withCredentials([
                string(credentialsId: 'SMTP_SERVER', variable: 'SMTP_SERVER'),
                string(credentialsId: 'SMTP_PORT', variable: 'SMTP_PORT'),
                string(credentialsId: 'SMTP_USER', variable: 'SMTP_USER'),
                string(credentialsId: 'SMTP_PASSWORD', variable: 'SMTP_PASSWORD')
            ]) {
                script {
                    def executionTime = currentBuild.durationString.replace(' and counting', '')
                    def restoreRunTs = "${new Date().format('dd-MM-yyyy-HH', TimeZone.getTimeZone('Asia/Kolkata'))}-build${env.BUILD_NUMBER}"
                    int notifyRc = bat(returnStatus: true, script: """
                        @echo off
                        setlocal
                        if not exist "%NOTIFY_SCRIPT_DIR%\\sendDbPipelineEmail.js" (
                            echo WARN: Notification script missing at %NOTIFY_SCRIPT_DIR%\\sendDbPipelineEmail.js. Skipping email.
                            exit /b 0
                        )
                        node "%NOTIFY_SCRIPT_DIR%\\sendDbPipelineEmail.js" ^
                        --smtpServer="%SMTP_SERVER%" ^
                        --smtpUser="%SMTP_USER%" ^
                        --smtpPassword="%SMTP_PASSWORD%" ^
                        --smtpPort="%SMTP_PORT%" ^
                        --senderName="DevOps QASIP" ^
                        --senderEmail="copper@qasource.com" ^
                        --receiverEmail="${env.NOTIFY_EMAILS}" ^
                        --pipelineType="restore" ^
                        --projectTargetMachine="${params.PROJECT_TARGET_MACHINE}" ^
                        --projectName="${env.PROJECT_NAME}" ^
                        --status="failure" ^
                        --executionTime="${executionTime}" ^
                        --buildNumber="${restoreRunTs}"
                    """)
                    if (notifyRc != 0) {
                        echo "WARN: Failure notification email step returned exit code ${notifyRc}. Continuing."
                    }
                }
            }
            echo "DB restore pipeline failed. Check logs for exact failure point."
        }
    }
}
